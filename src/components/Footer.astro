---
import { SITE, SOCIALS } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <span class="stripes" aria-hidden="true"><i></i><i></i><i></i></span>
    <div class="row">
      <a class="sign" href="/">{SITE.author}</a>
      <ul class="links">
        {SOCIALS.map((s) => <li><a href={s.href} rel="me noopener">{s.label}</a></li>)}
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </div>
    <p class="fine">© {year} · made by hand, played on tape</p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); }
  .inner {
    max-width: calc(var(--wide) + var(--rail) + var(--gutter) * 2);
    margin-inline: auto;
    padding: 2.5rem var(--gutter) 3rem;
  }
  .stripes { width: 4.5rem; margin-bottom: 1.75rem; }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .sign {
    font-family: var(--font-head);
    font-weight: 800;
    font-stretch: 115%;
    font-size: clamp(1.4rem, 3vw, 2rem);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .links { display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; list-style: none; padding: 0; }
  .links a {
    font-family: var(--font-ui);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--fg-soft);
  }
  .links a:hover { color: var(--stripe-2); }
  .fine { margin-top: 1.25rem; font-family: var(--font-ui); font-size: 0.7rem; color: var(--fg-faint); }
</style>
