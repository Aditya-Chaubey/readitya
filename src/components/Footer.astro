---
import { SITE, SOCIALS } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <div class="plate">
      <i class="screw" aria-hidden="true"></i><i class="screw" aria-hidden="true"></i>
      <div class="row">
        <a class="sign" href="/">
          <span class="stripes" aria-hidden="true"><i></i><i></i><i></i></span>
          {SITE.author}
        </a>
        <ul class="links">
          {SOCIALS.map((s) => <li><a href={s.href} rel="me noopener">{s.label}</a></li>)}
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </div>
      <p class="fine"><span>© {year}</span><span>Made by hand · played on tape</span></p>
    </div>
  </div>
</footer>

<style>
  .inner {
    max-width: calc(var(--wide) + var(--gutter) * 2);
    margin-inline: auto;
    padding: 0 var(--gutter) 2rem;
  }
  /* a deck's bottom plate: plastic, screwed down */
  .plate {
    position: relative;
    padding: 1.75rem clamp(1.25rem, 3vw, 2.25rem) 1.4rem;
    border-radius: 16px;
    background: linear-gradient(180deg, var(--plastic), var(--plastic-2));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.55), 0 1px 2px rgb(0 0 0 / 0.08);
  }
  :global(:root[data-theme='dark']) .plate { box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.05), 0 0 0 1px #000; }
  .screw {
    position: absolute;
    top: 0.75rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff, #b5ad9e 50%, #6d665a);
    opacity: 0.7;
  }
  .screw:first-child { left: 0.75rem; }
  .screw:nth-child(2) { right: 0.75rem; }
  .row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; }
  .sign {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--font-head);
    font-weight: 800;
    font-stretch: 115%;
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
    text-transform: uppercase;
    text-decoration: none;
  }
  .sign .stripes { width: 2.4rem; }
  .links { display: flex; flex-wrap: wrap; gap: 0.4rem 1.3rem; list-style: none; padding: 0; }
  .links a {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--fg-soft);
  }
  .links a:hover { color: var(--stripe-2); }
  .fine {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.25rem;
    padding-top: 0.9rem;
    border-top: 1px dashed var(--line);
    font-family: var(--font-ui);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
</style>
