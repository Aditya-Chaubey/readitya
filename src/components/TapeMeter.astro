---
/**
 * A little tape window that winds as you read: tape moves from the left
 * reel to the right one and the counter runs 000 → 999.
 * Driven by --read-p (0…1), which Page.astro keeps up to date on long reads.
 */
const teeth = [0, 60, 120, 180, 240, 300];
---

<div class="tape-meter" aria-hidden="true">
  <i class="screw"></i><i class="screw"></i>
  <svg viewBox="0 0 200 90">
    <rect x="2" y="2" width="196" height="86" rx="12" class="window" />
    <circle cx="60" cy="45" r="36" class="pack pack-l" />
    <circle cx="140" cy="45" r="36" class="pack pack-r" />
    <path d="M60 81 L100 84 L140 81" class="tape" />
    {
      [60, 140].map((cx) => (
        <g transform={`translate(${cx} 45)`}>
          <g class="hub">
            <circle r="12" class="hub-face" />
            {teeth.map((a) => <rect x="-1.8" y="-8" width="3.6" height="4" rx="0.6" transform={`rotate(${a})`} class="tooth" />)}
            <circle r="3.4" class="hub-hole" />
          </g>
        </g>
      ))
    }
    <rect x="2" y="2" width="196" height="86" rx="12" class="glass" />
  </svg>
  <div class="readout">
    <span>Now reading</span>
    <span class="counter" data-counter>000</span>
  </div>
</div>

<script>
  const counters = document.querySelectorAll<HTMLElement>('[data-counter]');
  if (counters.length) {
    let frame = 0;
    const tick = () => {
      frame = 0;
      const max = document.documentElement.scrollHeight - innerHeight;
      const p = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
      const txt = String(Math.round(p * 999)).padStart(3, '0');
      counters.forEach((c) => (c.textContent = txt));
    };
    addEventListener('scroll', () => { if (!frame) frame = requestAnimationFrame(tick); }, { passive: true });
    tick();
  }
</script>

<style>
  .tape-meter {
    position: relative;
    padding: 0.9rem 0.9rem 0.75rem;
    border-radius: 14px;
    background: linear-gradient(180deg, var(--plastic), var(--plastic-2));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.6), 0 8px 20px -14px rgb(0 0 0 / 0.5), 0 0 0 1px rgb(0 0 0 / 0.05);
  }
  :global(:root[data-theme='dark']) .tape-meter { box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), 0 0 0 1px #000; }
  .screw {
    position: absolute;
    top: 0.4rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff, #b5ad9e 50%, #6d665a);
    opacity: 0.7;
  }
  .screw:first-child { left: 0.45rem; }
  .screw:nth-child(2) { right: 0.45rem; }
  svg { display: block; width: 100%; height: auto; }
  .window { fill: #15110e; }
  .pack { fill: #4b3427; transform-box: fill-box; transform-origin: center; transition: transform 0.15s linear; }
  .pack-l { transform: scale(calc((15 + 21 * (1 - var(--read-p, 0))) / 36)); }
  .pack-r { transform: scale(calc((15 + 21 * var(--read-p, 0)) / 36)); }
  .tape { fill: none; stroke: #4b3427; stroke-width: 1.5; }
  .hub { transform-box: fill-box; transform-origin: center; transform: rotate(calc(var(--read-p, 0) * -1800deg)); }
  .hub-face { fill: #efe6d2; }
  .tooth { fill: var(--sec); }
  .hub-hole { fill: #15110e; }
  .glass { fill: rgb(255 255 255 / 0.06); stroke: rgb(255 255 255 / 0.12); }
  .readout {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.6rem;
    font-family: var(--font-ui);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .counter {
    padding: 0.15rem 0.45rem;
    border-radius: 5px;
    background: var(--glass);
    color: var(--vfd);
    text-shadow: 0 0 5px var(--vfd-glow);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    font-variant-numeric: tabular-nums;
  }
</style>
