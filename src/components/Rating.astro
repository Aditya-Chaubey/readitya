---
/** Five little level blocks: full, half, empty. */
interface Props {
  value: number;
}
const { value } = Astro.props;
const dots = Array.from({ length: 5 }, (_, i) => (value >= i + 1 ? 'full' : value >= i + 0.5 ? 'half' : 'empty'));
---

<span class="rating" role="img" aria-label={`Rated ${value} out of 5`} title={`${value} / 5`}>
  {dots.map((d) => <i class={d}></i>)}
</span>

<style>
  .rating { display: inline-flex; gap: 3px; vertical-align: middle; }
  i {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 3px;
    background: color-mix(in srgb, var(--fg) 12%, transparent);
  }
  .full { background: var(--sec); }
  .half { background: linear-gradient(90deg, var(--sec) 50%, color-mix(in srgb, var(--fg) 12%, transparent) 50%); }
</style>
