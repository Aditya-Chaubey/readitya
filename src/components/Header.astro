---
import { NAV, SITE } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';

const { section } = Astro.props as { section?: string };
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string, label: string) => path === href || path.startsWith(href + '/') || section === label;
---

<header class="site-header" id="site-header">
  <div class="inner">
    <a class="brand" href="/" aria-label={`${SITE.author} — home`}>
      <svg class="tape" viewBox="0 0 32 20" width="28" height="18" aria-hidden="true">
        <rect x="1" y="1" width="30" height="18" rx="3" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
        <rect x="6" y="5" width="20" height="7" rx="3.5" fill="none" stroke="currentColor" stroke-width="1.3"></rect>
        <circle class="hub" cx="10.5" cy="8.5" r="1.7" fill="currentColor"></circle>
        <circle class="hub" cx="21.5" cy="8.5" r="1.7" fill="currentColor"></circle>
        <path d="M9 19l2-4h10l2 4" fill="none" stroke="currentColor" stroke-width="1.3"></path>
      </svg>
      <span>{SITE.author}</span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} style={`--c:${item.color}`} aria-current={isActive(item.href, item.label) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="tools">
      <ThemeToggle />
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" aria-label="Menu">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="menu" id="menu" hidden>
    <ul>
      {
        NAV.map((item, i) => (
          <li style={`--i:${i};--c:${item.color}`}>
            <a href={item.href} aria-current={isActive(item.href, item.label) ? 'page' : undefined}>
              <span class="dot" aria-hidden="true"></span>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <span class="stripes" aria-hidden="true"><i></i><i></i><i></i></span>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const btn = header?.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('menu');

  // hairline under the header once the page scrolls
  const onScroll = () => header?.classList.toggle('scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // mobile menu
  const setOpen = (open: boolean) => {
    if (!btn || !menu) return;
    btn.setAttribute('aria-expanded', String(open));
    if (open) {
      menu.hidden = false;
      requestAnimationFrame(() => requestAnimationFrame(() => menu.classList.add('open')));
    } else {
      menu.classList.remove('open');
      setTimeout(() => { if (!menu.classList.contains('open')) menu.hidden = true; }, 450);
    }
  };
  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  menu?.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) setOpen(false); });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    height: var(--head-h);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, background-color 0.5s;
  }
  .site-header.scrolled { border-bottom-color: var(--line); }
  .inner {
    height: 100%;
    max-width: calc(var(--wide) + var(--rail) + var(--gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    font-family: var(--font-head);
    font-weight: 750;
    font-stretch: 110%;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--fg);
    white-space: nowrap;
  }
  .brand .tape { color: var(--stripe-2); flex: none; transition: transform 0.4s var(--ease-spring); }
  .brand:hover { color: var(--fg); }
  .brand:hover .tape { transform: rotate(-8deg) scale(1.08); }
  .brand:hover .hub { animation: spin 0.8s linear infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .nav ul { display: flex; gap: 0.25rem; list-style: none; padding: 0; }
  .nav a {
    position: relative;
    display: block;
    padding: 0.45rem 0.75rem;
    border-radius: 99px;
    font-family: var(--font-ui);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--fg-soft);
    transition: color 0.2s, background-color 0.25s;
  }
  .nav a:hover { color: var(--fg); background: color-mix(in srgb, var(--c) 14%, transparent); }
  .nav a[aria-current='page'] { color: var(--fg); }
  /* the active section gets a little tape-coloured tab */
  .nav a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.1rem;
    width: 1.1rem;
    height: 3px;
    margin-left: -0.55rem;
    border-radius: 2px;
    background: var(--c);
    transform: scaleX(0);
    transition: transform 0.35s var(--ease-out);
  }
  .nav a[aria-current='page']::after { transform: scaleX(1); }

  .tools { display: flex; align-items: center; gap: 0.25rem; }
  .menu-btn {
    display: none;
    position: relative;
    width: 2.4rem;
    height: 2.4rem;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
  }
  .menu-btn span {
    position: absolute;
    left: 50%;
    width: 18px;
    height: 2px;
    margin-left: -9px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.35s var(--ease-out), top 0.35s var(--ease-out);
  }
  .menu-btn span:first-child { top: calc(50% - 4px); }
  .menu-btn span:last-child { top: calc(50% + 3px); }
  .menu-btn[aria-expanded='true'] span:first-child { top: calc(50% - 1px); transform: rotate(45deg); }
  .menu-btn[aria-expanded='true'] span:last-child { top: calc(50% - 1px); transform: rotate(-45deg); }

  /* mobile menu: a full panel that slides in from the side */
  .menu {
    position: fixed;
    top: var(--head-h);
    right: 0;
    height: calc(100dvh - var(--head-h));
    width: min(100%, 26rem);
    padding: 2.5rem var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background:
      radial-gradient(ellipse at 100% 0%, color-mix(in srgb, var(--stripe-1) 30%, transparent), transparent 60%),
      var(--surface);
    border-left: 1px solid var(--line);
    transform: translateX(100%);
    transition: transform 0.45s var(--ease-out);
  }
  .menu.open { transform: none; }
  .menu ul { list-style: none; padding: 0; display: grid; gap: 0.4rem; }
  .menu li {
    opacity: 0;
    transform: translateX(24px);
    transition: opacity 0.4s, transform 0.5s var(--ease-out);
    transition-delay: calc(var(--i) * 45ms + 0.1s);
  }
  .menu.open li { opacity: 1; transform: none; }
  .menu a {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--font-head);
    font-weight: 800;
    font-stretch: 115%;
    font-size: clamp(2rem, 9vw, 2.8rem);
    line-height: 1.15;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--fg);
  }
  .menu a:hover, .menu a[aria-current='page'] { color: var(--c); }
  .menu .dot { width: 0.6rem; height: 0.6rem; border-radius: 2px; background: var(--c); flex: none; }
  .menu .stripes { width: 6rem; }

  @media (max-width: 760px) {
    .nav { display: none; }
    .menu-btn { display: inline-block; }
  }
</style>
