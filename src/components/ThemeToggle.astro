<button class="theme-switch" type="button" role="switch" aria-checked="false" aria-label="Dark mode" title="Light / dark">
  <span class="track" aria-hidden="true">
    <svg class="ico sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" fill="currentColor"></circle><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
    <svg class="ico moon" viewBox="0 0 24 24"><path d="M19.5 14.6A8 8 0 0 1 9.4 4.5a8 8 0 1 0 10.1 10.1Z" fill="currentColor"></path></svg>
    <span class="knob"></span>
  </span>
</button>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.documentElement;

  for (const btn of document.querySelectorAll<HTMLButtonElement>('.theme-switch')) {
    const sync = () => btn.setAttribute('aria-checked', String(root.dataset.theme === 'dark'));
    sync();
    btn.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      const apply = () => {
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        document.querySelectorAll('.theme-switch').forEach((b) => b.setAttribute('aria-checked', String(next === 'dark')));
      };
      if (reduced || !document.startViewTransition) return apply();

      // the new theme spreads out from the switch like a lamp coming on
      const r = btn.getBoundingClientRect();
      const x = r.left + r.width / 2;
      const y = r.top + r.height / 2;
      const end = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      root.classList.add('theme-vt');
      const t = document.startViewTransition(apply);
      t.ready
        .then(() => {
          root.animate(
            { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${end}px at ${x}px ${y}px)`] },
            { duration: 700, easing: 'cubic-bezier(.65,0,.35,1)', pseudoElement: '::view-transition-new(root)' },
          );
        })
        .catch(() => {});
      t.finished.finally(() => root.classList.remove('theme-vt')).catch(() => {});
    });
  }
</script>

<style>
  .theme-switch {
    display: inline-grid;
    place-items: center;
    padding: 0.35rem;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .track {
    position: relative;
    display: block;
    width: 3.1rem;
    height: 1.6rem;
    border-radius: 99px;
    background: var(--plastic-2);
    box-shadow: inset 0 1px 3px rgb(0 0 0 / 0.35), 0 1px 0 rgb(255 255 255 / 0.5);
  }
  :global(:root[data-theme='dark']) .track { box-shadow: inset 0 1px 3px #000, 0 1px 0 rgb(255 255 255 / 0.06); }
  .ico { position: absolute; top: 50%; width: 0.8rem; height: 0.8rem; margin-top: -0.4rem; color: var(--fg-faint); }
  .sun { left: 0.42rem; }
  .moon { right: 0.42rem; }
  .knob {
    position: absolute;
    top: 0.15rem;
    left: 0.15rem;
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 30%, #fff, var(--key-2) 75%);
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.35), inset 0 -1px 2px rgb(0 0 0 / 0.15);
    transition: transform 0.4s var(--ease-spring);
  }
  .theme-switch[aria-checked='true'] .knob { transform: translateX(1.5rem); background: radial-gradient(circle at 40% 30%, #6b6560, #2b2826 75%); }
  .theme-switch:hover .ico { color: var(--fg); }
</style>
