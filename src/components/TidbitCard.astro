---
import { render } from 'astro:content';
import { formatDate, type Tidbit } from '../lib/utils';
import { SITE } from '../site.config';

interface Props {
  tidbit: Tidbit;
  /** On its own permalink page: the title (if any) becomes the h1. */
  standalone?: boolean;
}
const { tidbit, standalone = false } = Astro.props;
const { Content } = await render(tidbit);
const url = `/tidbits/${tidbit.id}/`;
const Heading = standalone ? 'h1' : 'h2';
const time = tidbit.data.date.toLocaleTimeString(SITE.locale, {
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
  timeZone: SITE.timezone,
});
---

<article class:list={['entry', { standalone }]} id={standalone ? undefined : tidbit.id}>
  <a class="when" href={url} aria-label={`Permalink — ${formatDate(tidbit.data.date)}`}>
    <time datetime={tidbit.data.date.toISOString()}>
      <span class="d">{formatDate(tidbit.data.date)}</span>
      <span class="h">{time}</span>
    </time>
  </a>
  <div class="body">
    {tidbit.data.draft && <span class="stamp">draft</span>}
    {tidbit.data.title && <Heading class="title">{tidbit.data.title}</Heading>}
    <div class="prose">
      <Content />
    </div>
    {
      tidbit.data.tags.length > 0 && (
        <ul class="tags">
          {tidbit.data.tags.map((t) => <li>#{t}</li>)}
        </ul>
      )
    }
  </div>
</article>

<style>
  .entry {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 0.5rem 2rem;
    padding: 2rem 0;
    border-top: 1px solid var(--line);
  }
  .when {
    position: sticky;
    top: calc(var(--head-h) + 1.5rem);
    align-self: start;
    text-decoration: none;
    color: var(--fg-faint);
  }
  .when time { display: grid; gap: 0.15rem; font-family: var(--font-ui); font-size: 0.72rem; letter-spacing: 0.05em; text-transform: uppercase; }
  .when .h { opacity: 0.7; }
  .when::before {
    content: '';
    display: block;
    width: 0.55rem;
    height: 0.55rem;
    margin-bottom: 0.6rem;
    border-radius: 2px;
    background: var(--sec);
    transition: transform 0.35s var(--ease-spring);
  }
  .when:hover { color: var(--accent); }
  .when:hover::before { transform: rotate(45deg) scale(1.2); }
  .title {
    font-family: var(--font-head);
    font-weight: 700;
    font-stretch: 105%;
    font-size: 1.4rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-bottom: 0.5rem;
  }
  .standalone .title { font-size: clamp(1.9rem, 4vw, 2.8rem); font-weight: 800; }
  .standalone { border-top: 0; padding-top: 0.5rem; }
  .standalone .prose { font-size: 1.12em; }
  .stamp { margin-bottom: 0.6rem; }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    list-style: none;
    padding: 0;
    margin-top: 1rem;
    font-family: var(--font-ui);
    font-size: 0.7rem;
    color: var(--fg-faint);
  }
  @media (max-width: 640px) {
    .entry { grid-template-columns: 1fr; gap: 0.6rem; }
    .when { position: static; }
    .when time { display: flex; gap: 0.75rem; }
    .when::before { display: none; }
  }
</style>
