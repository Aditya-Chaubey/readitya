---
import { render } from 'astro:content';
import { formatDateTime, type Tidbit } from '../lib/utils';

interface Props {
  tidbit: Tidbit;
  /** Render the title as an h1 (on the permalink page). */
  standalone?: boolean;
}
const { tidbit, standalone = false } = Astro.props;
const { Content } = await render(tidbit);
const url = `/tidbits/${tidbit.id}/`;
const Heading = standalone ? 'h1' : 'h2';
---

<article class:list={['card', { standalone }]} id={standalone ? undefined : tidbit.id} style={`--tape-r:${(tidbit.id.length % 5) - 2}deg;--tape-x:${30 + (tidbit.id.charCodeAt(tidbit.id.length - 1) % 40)}%`}>
  <span class="washi" aria-hidden="true"></span>
  <header class="card-head">
    <a class="when" href={url}>
      <time datetime={tidbit.data.date.toISOString()}>{formatDateTime(tidbit.data.date)}</time>
    </a>
    {tidbit.data.draft && <span class="stamp">draft</span>}
  </header>
  {tidbit.data.title && <Heading class="card-title">{tidbit.data.title}</Heading>}
  <div class="prose">
    <Content />
  </div>
  {
    tidbit.data.tags.length > 0 && (
      <ul class="tags">
        {tidbit.data.tags.map((t) => <li>#{t}</li>)}
      </ul>
    )
  }
</article>

<style>
  .card {
    position: relative;
    padding: 1.1rem 1.4rem 1.25rem;
    background:
      linear-gradient(var(--paper-2), var(--paper-2)) padding-box;
    border: 1px solid var(--rule);
    border-radius: 3px;
    box-shadow: 0 10px 20px -16px rgb(var(--shadow) / 0.6);
  }
  .card { transition: transform 0.4s var(--ease-out), box-shadow 0.4s; }
  .card:not(.standalone):hover { transform: translateY(-3px) rotate(-0.3deg); box-shadow: 0 22px 30px -20px rgb(var(--shadow) / 0.6); }
  /* a strip of washi tape holding the card down */
  .washi {
    position: absolute;
    top: -11px;
    left: var(--tape-x, 40%);
    width: 92px;
    height: 24px;
    transform: rotate(var(--tape-r, -2deg));
    background:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.18) 0 6px, transparent 6px 12px),
      color-mix(in srgb, var(--gold) 55%, transparent);
    clip-path: polygon(0 8%, 4% 0, 8% 10%, 12% 0, 16% 8%, 20% 0, 80% 0, 84% 10%, 88% 0, 92% 8%, 96% 0, 100% 10%, 100% 92%, 96% 100%, 92% 90%, 88% 100%, 84% 92%, 80% 100%, 20% 100%, 16% 90%, 12% 100%, 8% 92%, 4% 100%, 0 90%);
    opacity: 0.85;
    z-index: 1;
  }
  /* the red rule of an index card */
  .card::before {
    content: '';
    position: absolute;
    left: 0; right: 0; top: 2.65rem;
    height: 0;
    border-top: 1.5px solid color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .card-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.15rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-faint);
  }
  .label {
    font-family: var(--font-stamp);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
  }
  .when { color: var(--ink-faint); text-decoration: none; }
  .when:hover { color: var(--accent); text-decoration: underline; }
  .card-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.45rem;
    line-height: 1.2;
    margin-bottom: 0.5rem;
  }
  .standalone .card-title { font-size: clamp(1.9rem, 4vw, 2.4rem); }
  .prose :global(p) { text-align: left; }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-faint);
  }
</style>
