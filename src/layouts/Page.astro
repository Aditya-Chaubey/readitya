---
/**
 * Every page except the home page: a wide column under the deck-style
 * header, tinted with the section's colour. On wide screens the section
 * name runs sideways down a rail on the left, like a cassette's spine.
 */
import Base from './Base.astro';
import { NAV } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  /** Which section this page belongs to (sets the colour). */
  section?: string;
  type?: 'website' | 'article';
  /** Override the section colour. */
  color?: string;
  /** Long read: a thin reading bar along the top. */
  progress?: boolean;
}
const { title, description, section, type, progress = false } = Astro.props;
const nav = NAV.find((n) => n.label === section);
const color = Astro.props.color ?? nav?.color ?? '#d9532e';
// on the section's own index page the rail is just a label; elsewhere it links back
const railHref = nav && Astro.url.pathname.replace(/\/$/, '') !== nav.href ? nav.href : undefined;
---

<Base title={title} description={description} section={section} type={type}>
  <slot name="head" slot="head" />
  <div class="wrap" style={`--sec:${color}`}>
    {progress && <div class="progress" aria-hidden="true" />}
    <main id="main" class:list={['main', { 'has-rail': section }]}>
      {
        section && (
          <div class="rail" aria-hidden="true">
            {railHref ? <a href={railHref} tabindex="-1">{section}</a> : <span>{section}</span>}
          </div>
        )
      }
      <div class="main-body">
        <slot />
      </div>
    </main>
  </div>
</Base>

{
  progress && (
    <script>
      // reading position → --read-p (0…1) on <html>; drives the top bar and the tape meter
      const root = document.documentElement;
      let frame = 0;
      const update = () => {
        frame = 0;
        const max = root.scrollHeight - innerHeight;
        root.style.setProperty('--read-p', String(max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0));
      };
      addEventListener('scroll', () => { if (!frame) frame = requestAnimationFrame(update); }, { passive: true });
      addEventListener('resize', update);
      update();
    </script>
  )
}
