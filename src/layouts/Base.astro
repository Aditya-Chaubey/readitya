---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '@fontsource/permanent-marker/400.css';
import '../styles/global.css';
import headFont from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import textFont from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  /** The home page: keeps the header, drops the footer, fills the screen. */
  home?: boolean;
  /** Section name, for the header highlight. */
  section?: string;
  type?: 'website' | 'article';
}

const { title, description = SITE.description, home = false, section, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={headFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} — Writings`} href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} — Tidbits`} href="/tidbits/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#f1ede5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121011" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (() => {
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <slot name="head" />
  </head>
  <body class:list={{ home }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header section={section} />
    <slot />
    {!home && <Footer />}
  </body>
</html>
