---
import Page from '../../layouts/Page.astro';
import SectionHead from '../../components/SectionHead.astro';
import { getDeepCuts } from '../../data/deepCuts';
import { formatDate } from '../../lib/utils';

const stories = getDeepCuts();
const [lead, ...rest] = stories;
const no = (i: number) => String(stories.length - i).padStart(2, '0');
---

<Page title="Deep Cuts" section="Deep Cuts" description="Long, visual, hand-built stories about how things work — interactive essays with diagrams you can play with.">
  <SectionHead
    section="Deep Cuts"
    lede="Long, visual, hand-built stories about how things work. Every one is an interactive essay — diagrams you can drag, models you can break, ideas you can poke at until they make sense."
    count={stories.length}
  />

  {
    lead && (
      <a class="lead reveal" href={`/deep-cuts/${lead.slug}/`} style={`--c:${lead.color}`}>
        <figure class="lead-art">
          <img src={lead.cover} alt="" width="800" height="500" />
          <span class="badge">New · No. {no(0)}</span>
        </figure>
        <div class="lead-copy">
          <p class="kick">{lead.kicker}</p>
          <h2>{lead.title}</h2>
          <p class="deck">{lead.deck}</p>
          <p class="meta">
            <time datetime={lead.date}>{formatDate(new Date(lead.date))}</time>
            <span>{lead.minutes} min</span>
            <span>{lead.interactives} interactives</span>
          </p>
          <span class="go">Read the story ▶</span>
        </div>
      </a>
    )
  }

  {
    rest.length > 0 && (
      <section class="more" aria-label="More stories">
        <h2 class="label">More deep cuts</h2>
        <ul class="grid">
          {rest.map((s, i) => (
            <li class="reveal" style={`--n:${i};--c:${s.color}`}>
              <a class="card" href={`/deep-cuts/${s.slug}/`}>
                <figure>
                  <img src={s.cover} alt="" width="800" height="500" loading="lazy" />
                  <span class="badge">No. {no(i + 1)}</span>
                </figure>
                <div class="body">
                  <p class="kick">{s.kicker}</p>
                  <h3>{s.title}</h3>
                  <p class="deck">{s.deck}</p>
                  <p class="meta">
                    <span>{s.minutes} min</span>
                    <span>{s.interactives} interactives</span>
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Page>

<style>
  .lead {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(1.25rem, 3.5vw, 2.75rem);
    align-items: center;
    padding: clamp(0.9rem, 2vw, 1.25rem);
    border-radius: var(--radius);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: transform 0.4s var(--ease-out);
  }
  .lead:hover { transform: translateY(-4px); }
  figure { position: relative; margin: 0; overflow: hidden; border-radius: calc(var(--radius) - 4px); background: #12382a; }
  figure img { display: block; width: 100%; height: auto; aspect-ratio: 8 / 5; object-fit: cover; transition: transform 0.9s var(--ease-out); }
  .lead:hover img, .card:hover img { transform: scale(1.04); }
  .badge {
    position: absolute;
    left: 0.8rem;
    top: 0.8rem;
    padding: 0.3em 0.7em;
    border-radius: 999px;
    font-family: var(--font-ui);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: rgb(0 0 0 / 0.45);
    backdrop-filter: blur(6px);
  }
  .kick {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sec-fg, var(--sec));
  }
  .lead h2 {
    margin: 0.5rem 0 0.8rem;
    font-family: var(--font-head);
    font-weight: 800;
    font-stretch: 106%;
    font-size: clamp(2rem, 4vw, 3.3rem);
    line-height: 1;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .deck { color: var(--fg-soft); line-height: 1.5; }
  .lead .deck { font-size: clamp(1.02rem, 0.5vw + 0.9rem, 1.2rem); }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: 1rem;
    font-family: var(--font-ui);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .go { display: inline-block; margin-top: 1.4rem; font-family: var(--font-ui); font-size: 0.8rem; color: var(--fg); transition: color 0.2s; }
  .lead:hover .go { color: var(--accent); }

  .more { margin-top: clamp(2.5rem, 7vh, 4rem); }
  .more .label { margin-bottom: 1rem; }
  .grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: 1.25rem; }
  .card {
    display: grid;
    height: 100%;
    grid-template-rows: auto 1fr;
    padding: 0.7rem;
    border-radius: var(--radius);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: transform 0.4s var(--ease-out);
  }
  .card:hover { transform: translateY(-4px); }
  .body { padding: 1rem 0.4rem 0.5rem; }
  .card h3 {
    margin: 0.4rem 0 0.5rem;
    font-family: var(--font-head);
    font-weight: 700;
    font-stretch: 104%;
    font-size: 1.45rem;
    line-height: 1.12;
    letter-spacing: -0.015em;
    transition: color 0.25s;
  }
  .card:hover h3 { color: var(--accent); }
  .card .deck { font-size: 0.95rem; }
  @media (max-width: 760px) {
    .lead { grid-template-columns: 1fr; }
  }
</style>
