---
import Page from '../layouts/Page.astro';
import { Content, frontmatter } from '../content/about.md';
import { SITE, SOCIALS } from '../site.config';
import Title from '../components/Title.astro';

const initials = SITE.author.split(' ').map((w) => w[0]).join('');
---

<Page title="About" section="About" description={frontmatter.description}>
  <div class="content">
    <header class="page-title">
      <Title text={frontmatter.title ?? 'About me'} />
      {frontmatter.lede && <p class="lede">{frontmatter.lede}</p>}
      <hr class="title-rule" />
    </header>

    <figure class="polaroid" data-tilt="14">
      {
        frontmatter.photo ? (
          <img src={frontmatter.photo} alt={`Portrait of ${SITE.author}`} width="220" height="220" />
        ) : (
          <div class="ph" aria-hidden="true">{initials}</div>
        )
      }
      <figcaption>{frontmatter.caption ?? 'me, probably'}</figcaption>
    </figure>

    <div class="prose dropcap">
      <Content />
    </div>

    <section class="elsewhere">
      <h2>Elsewhere</h2>
      <ul>
        {SOCIALS.map((s) => <li><a href={s.href} rel="me noopener">{s.label}</a></li>)}
      </ul>
    </section>
  </div>
</Page>

<style>
  .polaroid {
    float: right;
    width: 200px;
    margin: 0.25rem 0 1rem 1.75rem;
    padding: 10px 10px 0;
    background: #fbf7ee;
    box-shadow: 0 14px 24px -14px rgb(var(--shadow) / 0.6), 0 1px 3px rgb(var(--shadow) / 0.2);
    rotate: 2.5deg;
    animation: polaroid-in 1s var(--ease-spring) both 0.3s;
  }
  @keyframes polaroid-in { from { opacity: 0; translate: 30px -20px; rotate: 12deg; } }
  .polaroid::before {
    content: '';
    position: absolute;
    top: -12px;
    left: 50%;
    width: 80px;
    height: 22px;
    translate: -50% 0;
    rotate: -3deg;
    background: repeating-linear-gradient(90deg, rgb(255 255 255 / 0.2) 0 6px, transparent 6px 12px), color-mix(in srgb, var(--teal) 45%, transparent);
    opacity: 0.85;
  }
  :global(:root[data-theme='dark']) .polaroid { background: #e8dfcc; }
  .polaroid { position: relative; }
  .polaroid img, .ph {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .ph {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 25%, #e9c98d, #b5412f 70%, #6b2a1d);
    color: #fbf3e2;
    font-family: var(--font-display);
    font-size: 4.5rem;
    filter: sepia(0.25);
  }
  .polaroid figcaption {
    font-family: var(--font-hand);
    color: #2a1f17;
    text-align: center;
    padding: 0.5rem 0 0.7rem;
    font-size: 1rem;
  }
  .elsewhere {
    clear: both;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .elsewhere h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .elsewhere ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
  }
  .elsewhere a {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.3rem 0.8rem;
    border: 1.5px solid var(--ink);
    border-radius: 3px;
    text-decoration: none;
    box-shadow: 2px 2px 0 var(--ink);
    transition: transform 0.1s, box-shadow 0.1s;
  }
  .elsewhere a:hover { transform: translate(-1px, -1px); box-shadow: 3px 3px 0 var(--accent); }
  @media (max-width: 560px) {
    .polaroid { float: none; margin: 0 auto 2rem; }
  }
</style>
