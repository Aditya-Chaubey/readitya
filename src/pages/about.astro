---
import Page from '../layouts/Page.astro';
import { Content, frontmatter } from '../content/about.md';
import { SITE, SOCIALS } from '../site.config';
import Title from '../components/Title.astro';

const initials = SITE.author.split(' ').map((w) => w[0]).join('');
---

<Page title="About" section="About" description={frontmatter.description}>
  <div class="about">
    <div class="text">
      <header class="hero">
        <p class="display" aria-hidden="true">
          <span class="reels"><i></i><i></i></span>
          <span class="txt"><span class="dim">▶ Liner notes</span> <span class="lit">About</span></span>
        </p>
        <Title text={frontmatter.lede ?? frontmatter.title ?? 'About me'} class="headline" />
        {frontmatter.description && <p class="dek">{frontmatter.description}</p>}
      </header>
      <div class="prose">
        <Content />
      </div>
    </div>

    <aside class="side">
      <figure class="portrait">
        <div class="photo">
        {
          frontmatter.photo ? (
            <img src={frontmatter.photo} alt={`Portrait of ${SITE.author}`} width="480" height="600" />
          ) : (
            <div class="ph" aria-hidden="true">
              <span>{initials}</span>
            </div>
          )
        }
        </div>
        {frontmatter.caption && <figcaption>{frontmatter.caption}</figcaption>}
      </figure>
      <nav class="elsewhere" aria-label="Elsewhere">
        <p class="label">Elsewhere</p>
        <ul>
          {
            SOCIALS.map((s) => (
              <li>
                <a href={s.href} rel="me noopener">
                  <span>{s.label}</span>
                  <span class="arr" aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>
  </div>
</Page>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 20rem);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .prose { font-size: 1.1em; }
  .side { position: sticky; top: calc(var(--head-h) + 2rem); display: grid; gap: 2rem; }
  .portrait { margin: 0; }
  .portrait figcaption {
    margin-top: 0.7rem;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .photo {
    margin: 0;
    aspect-ratio: 4 / 5;
    border-radius: calc(var(--radius) + 6px);
    overflow: hidden;
    background: var(--surface-2);
    animation: photo-in 1.1s var(--ease-out) both 0.15s;
  }
  @keyframes photo-in { from { opacity: 0; transform: translateY(20px) scale(0.97); } }
  .photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ph {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background:
      linear-gradient(180deg, transparent 62%, var(--stripe-1) 62% 68%, var(--stripe-2) 68% 74%, var(--stripe-3) 74% 80%, transparent 80%),
      radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--sec) 45%, var(--surface)), var(--surface) 70%);
  }
  .ph span {
    font-family: var(--font-head);
    font-weight: 900;
    font-stretch: 125%;
    font-size: clamp(4rem, 9vw, 6.5rem);
    letter-spacing: -0.04em;
    color: var(--fg);
    translate: 0 -12%;
  }
  .elsewhere .label { margin-bottom: 0.5rem; }
  .elsewhere ul { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .elsewhere li { border-bottom: 1px solid var(--line); }
  .elsewhere a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 0.1rem;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.05rem;
    text-decoration: none;
    transition: color 0.2s, padding 0.35s var(--ease-out);
  }
  .elsewhere a:hover { padding-left: 0.5rem; }
  .arr { color: var(--accent); transition: transform 0.35s var(--ease-out); }
  .elsewhere a:hover .arr { transform: translate(3px, -3px); }
  @media (max-width: 900px) {
    .about { grid-template-columns: minmax(0, 1fr); }
    .side { position: static; grid-template-columns: minmax(0, 14rem) minmax(0, 1fr); align-items: end; }
  }
  @media (max-width: 520px) {
    .side { grid-template-columns: 1fr; }
    .portrait { max-width: 16rem; }
  }
</style>
