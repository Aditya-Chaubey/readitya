---
import Page from '../../layouts/Page.astro';
import ProjectArt from '../../components/ProjectArt.astro';
import StatusStamp from '../../components/StatusStamp.astro';
import { getProjects } from '../../lib/utils';
import Title from '../../components/Title.astro';

const projects = await getProjects();
const span = (p: (typeof projects)[number]) => {
  const a = p.data.started.getFullYear();
  const b = p.data.ended?.getFullYear();
  return b ? (a === b ? `${a}` : `${a}–${b}`) : `${a} —`;
};
---

<Page title="Projects" section="Projects" description="Things I'm building, tinkering with, and have shipped.">
  <div class="content">
    <header class="page-title">
      <Title text="Projects" />
      <p class="lede">Things I'm making.</p>
      <hr class="title-rule" />
    </header>

    {projects.length === 0 && <p class="muted"><em>Nothing here yet.</em></p>}

    <ul class="plates">
      {
        projects.map((p) => (
          <li class="reveal">
            <a class="plate" href={`/projects/${p.id}/`} data-tilt="5">
              <figure class="art">
                <span class="mat">
                  {p.data.cover ? (
                    <img src={p.data.cover} alt="" loading="lazy" width="400" height="250" />
                  ) : (
                    <ProjectArt seed={p.data.title} color={p.data.color} />
                  )}
                  <span class="sheen" aria-hidden="true" />
                </span>
                <span class="corner tl" aria-hidden="true" />
                <span class="corner tr" aria-hidden="true" />
                <span class="corner bl" aria-hidden="true" />
                <span class="corner br" aria-hidden="true" />
              </figure>
              <div class="info">
                <div class="row">
                  <StatusStamp status={p.data.status} />
                  <span class="when">{span(p)}</span>
                </div>
                <h2>{p.data.title}</h2>
                <p class="summary">{p.data.summary}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Page>

<style>
  .plates {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 2rem 1.75rem;
  }
  /* an odd one out at the top becomes a wide, featured plate */
  .plates > li:first-child:nth-last-child(odd) { grid-column: 1 / -1; }
  .plates > li:first-child:nth-last-child(odd) .plate { grid-template-columns: 1.15fr 1fr; align-items: center; }

  .plate {
    position: relative;
    display: grid;
    gap: 1.1rem;
    height: 100%;
    padding: 1rem 1rem 1.25rem;
    color: inherit;
    text-decoration: none;
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: 3px;
    box-shadow: 0 1px 0 var(--paper-edge), 0 18px 30px -22px rgb(var(--shadow) / 0.6);
    transform-style: preserve-3d;
  }
  .plate:hover { color: inherit; box-shadow: 0 1px 0 var(--paper-edge), 0 30px 40px -24px rgb(var(--shadow) / 0.65); }
  :global(:root[data-theme='dark']) .plate:hover { box-shadow: 0 30px 50px -24px rgb(0 0 0 / 0.9), 0 0 0 1px rgb(242 166 90 / 0.25); }

  .art { position: relative; margin: 0; }
  .mat {
    position: relative;
    display: block;
    aspect-ratio: 8 / 5;
    padding: 8px;
    background: #f8f2e4;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.15), inset 0 0 0 1px rgb(0 0 0 / 0.05);
    overflow: hidden;
  }
  :global(:root[data-theme='dark']) .mat { background: #e9dfca; filter: brightness(0.92); }
  .mat > :global(svg), .mat > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }
  .plate:hover .mat > :global(svg), .plate:hover .mat > img { transform: scale(1.05); }
  .sheen {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at var(--gx, 50%) var(--gy, 0%), rgb(255 255 255 / 0.35), transparent 50%);
    mix-blend-mode: soft-light;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .plate:hover .sheen { opacity: 1; }

  /* scrapbook photo corners */
  .corner {
    position: absolute;
    width: 22px;
    height: 22px;
    background: linear-gradient(135deg, #2a1f17 50%, transparent 50%);
    opacity: 0.85;
    filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.3));
  }
  :global(:root[data-theme='dark']) .corner { background: linear-gradient(135deg, #0d0a08 50%, transparent 50%); }
  .tl { left: -4px; top: -4px; }
  .tr { right: -4px; top: -4px; transform: rotate(90deg); }
  .br { right: -4px; bottom: -4px; transform: rotate(180deg); }
  .bl { left: -4px; bottom: -4px; transform: rotate(270deg); }
  .art figcaption {
    margin-top: 0.35rem;
    font-family: var(--font-body);
    font-style: italic;
    font-size: 0.9rem;
    text-align: center;
    color: var(--ink-faint);
  }

  .info { display: grid; gap: 0.5rem; align-content: start; transform: translateZ(20px); }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .when { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-faint); }
  h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.65rem;
    line-height: 1.15;
    margin-top: 0.2rem;
    text-wrap: balance;
  }
  .summary { color: var(--ink-soft); font-size: 1rem; line-height: 1.5; }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin-top: 0.2rem;
  }
  .stack li {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    padding: 0.1em 0.5em;
    background: var(--paper);
    border: 1px dashed var(--rule);
    border-radius: 2px;
    color: var(--ink-soft);
  }
  .more {
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.25s, transform 0.25s;
  }
  .plate:hover .more, .plate:focus-visible .more { opacity: 1; transform: none; }
  @media (hover: none) { .more { opacity: 1; transform: none; } }

  @media (max-width: 640px) {
    .plates > li:first-child:nth-last-child(odd) .plate { grid-template-columns: 1fr; }
  }
</style>
