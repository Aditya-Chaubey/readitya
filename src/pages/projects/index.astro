---
import Page from '../../layouts/Page.astro';
import ProjectArt from '../../components/ProjectArt.astro';
import StatusStamp from '../../components/StatusStamp.astro';
import SectionHead from '../../components/SectionHead.astro';
import { getProjects } from '../../lib/utils';

const projects = await getProjects();
const span = (p: (typeof projects)[number]) => {
  const a = p.data.started.getFullYear();
  const b = p.data.ended?.getFullYear();
  return b ? (a === b ? `${a}` : `${a}–${b}`) : `${a} —`;
};
---

<Page title="Projects" section="Projects" description="Things I'm making.">
  <SectionHead section="Projects" lede="Things I'm making — some shipped, most still on the workbench." count={projects.length} />

  {projects.length === 0 && <p class="muted">Nothing here yet.</p>}

  <ul class="grid">
    {
      projects.map((p, i) => (
        <li class="reveal" style={`--n:${i}`}>
          <a class="card" href={`/projects/${p.id}/`}>
            <figure class="art">
              {p.data.cover ? (
                <img src={p.data.cover} alt="" loading="lazy" width="800" height="500" />
              ) : (
                <ProjectArt seed={p.data.title} color={p.data.color} />
              )}
            </figure>
            <div class="info">
              <div class="tab" aria-hidden="true">
                <span>No. {String(i + 1).padStart(2, '0')}</span>
                <span class="stripes"><i /><i /><i /></span>
              </div>
              <div class="row">
                <StatusStamp status={p.data.status} />
                <span class="when">{span(p)}</span>
              </div>
              <h2>{p.data.title}</h2>
              <p class="summary">{p.data.summary}</p>
              {p.data.stack.length > 0 && (
                <ul class="stack" aria-label="Built with">
                  {p.data.stack.map((s) => <li>{s}</li>)}
                </ul>
              )}
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</Page>

<style>
  .grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 1.5rem;
  }
  /* an odd one out at the top becomes a wide, featured card */
  .grid > li:first-child:nth-last-child(odd) { grid-column: 1 / -1; }
  .grid > li:first-child:nth-last-child(odd) .card { grid-template-columns: 1.25fr 1fr; grid-template-rows: auto; }
  .grid > li:first-child:nth-last-child(odd) .art { aspect-ratio: auto; min-height: 100%; }
  .grid > li:first-child:nth-last-child(odd) .info { align-content: center; padding: clamp(1.5rem, 3vw, 2.5rem); }
  .grid > li:first-child:nth-last-child(odd) h2 { font-size: clamp(1.8rem, 3vw, 2.6rem); }

  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    box-shadow: 0 0 0 1px transparent;
    transition: transform 0.45s var(--ease-out), box-shadow 0.3s;
  }
  .card:hover {
    color: inherit;
    transform: translateY(-5px);
    box-shadow: 0 0 0 1.5px var(--sec), 0 24px 40px -24px color-mix(in srgb, var(--sec) 60%, transparent);
  }
  .art { margin: 0; aspect-ratio: 16 / 10; overflow: hidden; background: var(--surface-2); }
  .art > :global(svg), .art > img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out);
  }
  .card:hover .art > :global(svg), .card:hover .art > img { transform: scale(1.06); }
  :global(:root[data-theme='dark']) .art > :global(svg) { filter: brightness(0.85) saturate(0.95); }

  .info { display: grid; gap: 0.65rem; align-content: start; padding: 1.25rem 1.35rem 1.5rem; }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  /* a J-card style label tab */
  .tab {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 0.65rem;
    margin-bottom: 0.15rem;
    border-bottom: 1px dashed var(--line);
    font-family: var(--font-ui);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .tab .stripes { flex: 1; max-width: 3rem; margin-left: auto; }
  .tab .stripes i { height: 3px; }
  .when { font-family: var(--font-ui); font-size: 0.72rem; color: var(--fg-faint); }
  h2 {
    font-family: var(--font-head);
    font-weight: 750;
    font-stretch: 106%;
    font-size: 1.55rem;
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .summary { color: var(--fg-soft); line-height: 1.5; }
  .stack { display: flex; flex-wrap: wrap; gap: 0.35rem; list-style: none; padding: 0; margin-top: 0.2rem; }
  .stack li {
    font-family: var(--font-ui);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    padding: 0.2em 0.6em;
    border-radius: 6px;
    border: 1px solid var(--line);
    color: var(--fg-soft);
  }
  @media (max-width: 720px) {
    .grid > li:first-child:nth-last-child(odd) .card { grid-template-columns: 1fr; }
    .grid > li:first-child:nth-last-child(odd) .art { aspect-ratio: 16 / 10; }
  }
</style>
