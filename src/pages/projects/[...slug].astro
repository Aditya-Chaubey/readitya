---
import { render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import ProjectArt from '../../components/ProjectArt.astro';
import StatusStamp from '../../components/StatusStamp.astro';
import Title from '../../components/Title.astro';
import { formatMonth, getProjects, type Project } from '../../lib/utils';

export async function getStaticPaths() {
  const items = await getProjects();
  return items.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: items[i - 1], next: items[i + 1] },
  }));
}

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}
const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---

<Page title={d.title} description={d.summary} section="Projects" type="article">
  <header class="hero">
    <p class="display" aria-hidden="true">
      <span class="reels"><i></i><i></i></span>
      <span class="txt"><span class="dim">▶ Now playing</span> <span class="lit">Project</span></span>
    </p>
    <Title text={d.title} class="headline" />
    <p class="dek">{d.summary}</p>
    <p class="meta-row">
      <StatusStamp status={d.status} />
      {d.draft && <span class="stamp">draft</span>}
      <span>{formatMonth(d.started)}{d.ended ? ` – ${formatMonth(d.ended)}` : ' — now'}</span>
    </p>
    {
      (d.stack.length > 0 || d.links.length > 0) && (
        <div class="facts">
          {d.stack.length > 0 && (
            <ul class="stack" aria-label="Made with">
              {d.stack.map((s) => <li>{s}</li>)}
            </ul>
          )}
          {d.links.length > 0 && (
            <p class="links">
              {d.links.map((l) => (
                <a class="btn" href={l.url} rel="noopener">
                  {l.label} ↗
                </a>
              ))}
            </p>
          )}
        </div>
      )
    }
  </header>

  <figure class="cover">
    {d.cover ? <img src={d.cover} alt={`${d.title} — cover image`} width="1200" height="675" /> : <ProjectArt seed={d.title} color={d.color} />}
  </figure>

  <article class="prose">
    <Content />
  </article>

  {
    (prev || next) && (
      <nav class="pager" aria-label="More projects">
        {prev ? (
          <a href={`/projects/${prev.id}/`}>
            <span class="label">← Previous</span>
            <span class="pt">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {next ? (
          <a class="nx" href={`/projects/${next.id}/`}>
            <span class="label">Next →</span>
            <span class="pt">{next.data.title}</span>
          </a>
        ) : (
          <span />
        )}
      </nav>
    )
  }
</Page>

<style>
  .hero :global(.headline) { max-width: 18ch; }
  .facts { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; margin-top: 1.75rem; }
  .stack { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; }
  .stack li {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    padding: 0.3em 0.7em;
    border-radius: 6px;
    border: 1px solid var(--line);
    color: var(--fg-soft);
  }
  .links { display: flex; flex-wrap: wrap; gap: 0.6rem; }

  .cover {
    margin: 0 0 clamp(2.5rem, 6vh, 4rem);
    aspect-ratio: 16 / 8;
    overflow: hidden;
    border-radius: calc(var(--radius) + 4px);
    background: var(--surface-2);
  }
  .cover > :global(svg), .cover > img { display: block; width: 100%; height: 100%; object-fit: cover; }
  :global(:root[data-theme='dark']) .cover > :global(svg) { filter: brightness(0.85); }

  .prose { font-size: 1.1em; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: clamp(3rem, 8vh, 5rem); }
  .pager a {
    display: grid;
    gap: 0.4rem;
    padding: 1.25rem 1.4rem;
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition: transform 0.35s var(--ease-out), background-color 0.25s;
  }
  .pager a:hover { transform: translateY(-3px); background: color-mix(in srgb, var(--sec) 14%, var(--surface)); }
  .pager .nx { text-align: right; grid-column: 2; }
  .pt { font-family: var(--font-head); font-weight: 650; font-size: 1.15rem; }
  @media (max-width: 560px) {
    .pager { grid-template-columns: 1fr; }
    .pager .nx { grid-column: 1; }
    .cover { aspect-ratio: 16 / 10; }
  }
</style>
