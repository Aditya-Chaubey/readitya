---
import { render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import ProjectArt from '../../components/ProjectArt.astro';
import StatusStamp from '../../components/StatusStamp.astro';
import Title from '../../components/Title.astro';
import { formatMonth, getProjects, type Project } from '../../lib/utils';

export async function getStaticPaths() {
  const items = await getProjects();
  return items.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: items[i - 1], next: items[i + 1] },
  }));
}

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}
const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---

<Page title={d.title} description={d.summary} section="Projects" type="article">
  <div class="content">
    <header class="head">
      {d.draft && <p class="type"><span class="stamp">draft</span></p>}
      <Title text={d.title} />
      <p class="dek">{d.summary}</p>
      <hr class="title-rule" />
    </header>

    <dl class="specs">
      <div><dt>Status</dt><dd><StatusStamp status={d.status} /></dd></div>
      <div>
        <dt>{d.ended ? 'Ran' : 'Started'}</dt>
        <dd>{formatMonth(d.started)}{d.ended && <> – {formatMonth(d.ended)}</>}</dd>
      </div>
      {
        d.stack.length > 0 && (
          <div class="wide">
            <dt>Made with</dt>
            <dd class="stack">{d.stack.map((s) => <span>{s}</span>)}</dd>
          </div>
        )
      }
      {
        d.links.length > 0 && (
          <div class="wide">
            <dt>Links</dt>
            <dd class="links">
              {d.links.map((l) => (
                <a class="btn" href={l.url} rel="noopener">
                  {l.label} ↗
                </a>
              ))}
            </dd>
          </div>
        )
      }
    </dl>

    <figure class="plate-fig" data-tilt="4">
      <span class="mat">
        {d.cover ? <img src={d.cover} alt={`${d.title} — cover image`} width="800" height="500" /> : <ProjectArt seed={d.title} color={d.color} />}
      </span>
    </figure>

    <div class="prose">
      <Content />
    </div>

    <nav class="pager" aria-label="More projects">
      {prev ? <a href={`/projects/${prev.id}/`}><span class="eyebrow">← Previous</span><span class="t">{prev.data.title}</span></a> : <span />}
      {next ? <a class="nx" href={`/projects/${next.id}/`}><span class="eyebrow">Next →</span><span class="t">{next.data.title}</span></a> : <span />}
    </nav>
  </div>
</Page>

<style>
  .head { margin-bottom: 2rem; animation: none; }
  .type { display: flex; gap: 0.6rem; margin-bottom: 0.9rem; }
  .head :global(h1) {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.3rem, 5.5vw, 3.4rem);
    line-height: 1.08;
    text-wrap: balance;
  }
  .dek { margin-top: 0.8rem; font-style: italic; font-size: 1.18em; color: var(--ink-soft); text-wrap: pretty; }

  .specs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem 1.5rem;
    padding: 1rem 1.25rem;
    margin-bottom: 2.25rem;
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
  .specs .wide { grid-column: 1 / -1; }
  dt {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 0.25rem;
  }
  dd { margin: 0; font-family: var(--font-mono); font-size: 0.85rem; }
  .stack { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .stack span { padding: 0.05em 0.5em; border: 1px dashed var(--rule); background: var(--paper); border-radius: 2px; }
  .links { display: flex; flex-wrap: wrap; gap: 0.6rem; }

  .plate-fig { margin: 0 0 2.5rem; }
  .mat {
    display: block;
    aspect-ratio: 8 / 5;
    padding: 10px;
    background: #f8f2e4;
    box-shadow: 0 24px 40px -26px rgb(var(--shadow) / 0.7), 0 1px 3px rgb(0 0 0 / 0.15);
    overflow: hidden;
  }
  :global(:root[data-theme='dark']) .mat { background: #e9dfca; filter: brightness(0.92); box-shadow: 0 30px 50px -26px #000; }
  .mat > :global(svg), .mat > img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .plate-fig figcaption {
    margin-top: 0.6rem;
    text-align: center;
    font-style: italic;
    color: var(--ink-faint);
    font-size: 0.92rem;
  }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 3rem; }
  .pager a {
    display: grid;
    gap: 0.2rem;
    padding: 0.9rem 1rem;
    text-decoration: none;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-2);
    transition: border-color 0.2s, transform 0.2s;
  }
  .pager a:hover { border-color: var(--accent); transform: translateY(-2px); }
  .pager .nx { text-align: right; grid-column: 2; }
  .pager .t { font-family: var(--font-display); font-size: 1.15rem; }
  .back { margin-top: 1.75rem; text-align: center; font-family: var(--font-mono); font-size: 0.85rem; }
  @media (max-width: 520px) {
    .specs { grid-template-columns: 1fr; }
    .pager { grid-template-columns: 1fr; }
    .pager .nx { grid-column: 1; }
  }
</style>
