---
import Page from '../../layouts/Page.astro';
import TidbitCard from '../../components/TidbitCard.astro';
import { formatDateTime, getTidbits, type Tidbit } from '../../lib/utils';

export async function getStaticPaths() {
  const all = await getTidbits();
  return all.map((tidbit, i) => ({
    params: { id: tidbit.id },
    props: { tidbit, newer: all[i - 1], older: all[i + 1] },
  }));
}

interface Props {
  tidbit: Tidbit;
  newer?: Tidbit;
  older?: Tidbit;
}
const { tidbit, newer, older } = Astro.props;
const title = tidbit.data.title ?? `Tidbit from ${formatDateTime(tidbit.data.date)}`;
const excerpt = (tidbit.body ?? '').replace(/[#*_>`\[\]]/g, '').trim().slice(0, 150);
---

<Page title={title} description={excerpt} section="Tidbits" type="article">
  {!tidbit.data.title && <h1 class="sr-only">{title}</h1>}
  <TidbitCard tidbit={tidbit} standalone />
  <nav class="pager" aria-label="More tidbits">
    {older ? <a href={`/tidbits/${older.id}/`}>← Older</a> : <span />}
    <a href="/tidbits">All tidbits</a>
    {newer ? <a href={`/tidbits/${newer.id}/`}>Newer →</a> : <span />}
  </nav>
</Page>

<style>
  .pager {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .pager a { text-decoration: none; }
</style>
