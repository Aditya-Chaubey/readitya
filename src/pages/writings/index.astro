---
import Page from '../../layouts/Page.astro';
import Title from '../../components/Title.astro';
import { formatDate, getWritings, yearOf } from '../../lib/utils';

const posts = await getWritings();

// group by year, newest first
const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = yearOf(p.data.date);
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
---

<Page title="Writings" section="Writings" description="Essays and longer thoughts.">
  <div class="content">
    <header class="page-title">
      <Title text="Writings" />
      <p class="lede">Essays and longer thoughts.</p>
      <hr class="title-rule" />
    </header>

    {posts.length === 0 && <p class="muted"><em>Nothing here yet.</em></p>}

    {
      [...byYear].map(([year, list]) => (
        <section class="year" aria-label={String(year)}>
          <h2 class="year-head reveal">{year}</h2>
          <ol class="entries">
            {list.map((p) => (
              <li class="reveal">
                <a href={`/writings/${p.id}/`}>
                  <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
                  <span class="t">
                    {p.data.title}
                    {p.data.draft && <span class="stamp">draft</span>}
                  </span>
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</Page>

<style>
  .year + .year { margin-top: 3rem; }
  .year-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.6rem;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  .year-head::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--rule);
  }
  .entries { list-style: none; padding: 0; }
  .entries li + li { border-top: 1px solid color-mix(in srgb, var(--rule) 55%, transparent); }
  .entries a {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 7.5rem 1fr auto;
    gap: 0.25rem 1.25rem;
    align-items: baseline;
    padding: 0.95rem 0.75rem;
    margin-inline: -0.75rem;
    border-radius: 4px;
    color: inherit;
    text-decoration: none;
  }
  /* a wash of ink sweeps in behind the row */
  .entries a::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out);
  }
  .entries a:hover::before, .entries a:focus-visible::before { transform: scaleX(1); }
  time {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .t {
    font-size: 1.28rem;
    line-height: 1.3;
    transition: transform 0.45s var(--ease-out), color 0.25s;
  }
  .entries a:hover .t { transform: translateX(6px); color: var(--accent); }
  .arrow {
    color: var(--accent);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.3s, transform 0.45s var(--ease-out);
  }
  .entries a:hover .arrow { opacity: 1; transform: none; }
  .stamp { margin-left: 0.6rem; font-size: 0.6rem; vertical-align: middle; }
  @media (max-width: 520px) {
    .entries a { grid-template-columns: 1fr auto; }
    time { grid-column: 1 / -1; }
  }
</style>
