---
import Page from '../../layouts/Page.astro';
import { formatDate, getWritings, readingTime, wordCount, yearOf } from '../../lib/utils';

const posts = await getWritings();

const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = yearOf(p.data.date);
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
---

<Page title="Writings" section="Writings" index description="Essays and longer thoughts.">
  <header class="intro">
    <p class="lede">Essays and longer thoughts — written slowly, revised often.</p>
  </header>

  {posts.length === 0 && <p class="muted">Nothing here yet.</p>}

  {
    [...byYear].map(([year, list]) => (
      <section class="year" aria-label={String(year)}>
        <h2 class="year-num reveal" aria-hidden="true">{year}</h2>
        <ol class="rows">
          {list.map((p) => (
            <li class="reveal">
              <a href={`/writings/${p.id}/`}>
                <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
                <span class="t">
                  {p.data.title}
                  {p.data.draft && <span class="stamp">draft</span>}
                </span>
                <span class="m">
                  {p.data.type} · {readingTime(wordCount(p.body))} min
                </span>
                <span class="arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</Page>

<style>
  .year + .year { margin-top: clamp(2.5rem, 6vh, 4rem); }
  .year-num {
    font-family: var(--font-head);
    font-weight: 900;
    font-stretch: 120%;
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--fg) 30%, transparent);
    margin-bottom: 0.75rem;
  }
  .rows { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .rows li { border-bottom: 1px solid var(--line); }
  .rows a {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr) auto 1.5rem;
    align-items: baseline;
    gap: 0.35rem 1.75rem;
    padding: 1.35rem 0.25rem;
    color: inherit;
    text-decoration: none;
  }
  /* a band of the section colour sweeps in underneath */
  .rows a::before {
    content: '';
    position: absolute;
    inset: 0 -1rem;
    z-index: -1;
    border-radius: 10px;
    background: color-mix(in srgb, var(--sec) 11%, transparent);
    transform: scaleY(0.3);
    opacity: 0;
    transition: transform 0.45s var(--ease-out), opacity 0.3s;
  }
  .rows a:hover::before, .rows a:focus-visible::before { transform: none; opacity: 1; }
  time, .m {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-faint);
    white-space: nowrap;
  }
  .t {
    font-family: var(--font-head);
    font-weight: 650;
    font-stretch: 104%;
    font-size: clamp(1.25rem, 1.2vw + 0.9rem, 1.65rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    transition: transform 0.45s var(--ease-out), color 0.25s;
  }
  .rows a:hover .t { transform: translateX(6px); color: var(--accent); }
  .arrow {
    align-self: center;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-10px);
    transition: opacity 0.3s, transform 0.45s var(--ease-out);
  }
  .rows a:hover .arrow { opacity: 1; transform: none; }
  .stamp { margin-left: 0.6rem; vertical-align: middle; }
  @media (max-width: 680px) {
    .rows a { grid-template-columns: minmax(0, 1fr) auto; gap: 0.3rem 1rem; }
    time { grid-column: 1; grid-row: 1; }
    .t { grid-column: 1 / -1; grid-row: 2; }
    .m { grid-column: 2; grid-row: 1; text-align: right; }
    .arrow { display: none; }
  }
</style>
