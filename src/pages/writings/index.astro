---
import Page from '../../layouts/Page.astro';
import SectionHead from '../../components/SectionHead.astro';
import { formatDate, getWritings, wordCount, yearOf } from '../../lib/utils';

const posts = await getWritings();

// each year is one side of the tape: newest year = side A
const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = yearOf(p.data.date);
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const sides = [...byYear].map(([year, list], i) => ({ year, list, side: String.fromCharCode(65 + (i % 26)) }));

/** Reading time as a track length, e.g. 4:12 */
const length = (body?: string) => {
  const secs = Math.max(30, Math.round((wordCount(body) / 230) * 60));
  return `${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, '0')}`;
};
---

<Page title="Writings" section="Writings" description="Essays and longer thoughts.">
  <SectionHead section="Writings" lede="Essays and longer thoughts — written slowly, revised often." count={posts.length} />

  {posts.length === 0 && <p class="muted">Nothing recorded yet.</p>}

  {
    sides.map(({ year, list, side }) => (
      <section class="side" aria-label={`${year}`}>
        <h2 class="side-head reveal">
          <span class="side-badge">{side}</span>
          <span>Side {side}</span>
          <span class="yr">{year}</span>
        </h2>
        <ol class="tracks">
          {list.map((p, i) => (
            <li class="reveal">
              <a href={`/writings/${p.id}/`}>
                <span class="no">
                  <span class="num">{side}{i + 1}</span>
                  <svg class="play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5l9 5.5-9 5.5z" fill="currentColor" /></svg>
                </span>
                <span class="t">
                  {p.data.title}
                  {p.data.draft && <span class="stamp">draft</span>}
                </span>
                <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
                <span class="len">{length(p.body)}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</Page>

<style>
  .side + .side { margin-top: clamp(2.5rem, 6vh, 3.5rem); }
  .side-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-ui);
    font-weight: 400;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .side-badge {
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 0.85rem;
    color: #fff;
    background: var(--sec);
  }
  .yr { margin-left: auto; }

  .tracks { list-style: none; padding: 0; border-top: 2px solid var(--fg); }
  .tracks li { border-bottom: 1px dashed var(--line); }
  .tracks a {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr) auto 3.5rem;
    align-items: baseline;
    gap: 0.3rem 1.5rem;
    padding: 1.15rem 0.5rem;
    color: inherit;
    text-decoration: none;
  }
  .tracks a::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--sec) 10%, transparent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out);
  }
  .tracks a:hover::before, .tracks a:focus-visible::before { transform: none; }
  .no { position: relative; font-family: var(--font-ui); font-size: 0.8rem; color: var(--fg-faint); }
  .play {
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.9rem;
    height: 0.9rem;
    margin-top: -0.5rem;
    color: var(--accent);
    opacity: 0;
    transform: scale(0.5);
    transition: opacity 0.2s, transform 0.3s var(--ease-spring);
  }
  .num { transition: opacity 0.2s; }
  .tracks a:hover .play { opacity: 1; transform: none; }
  .tracks a:hover .num { opacity: 0; }
  .t {
    font-family: var(--font-head);
    font-weight: 650;
    font-stretch: 104%;
    font-size: clamp(1.2rem, 1vw + 0.9rem, 1.5rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    transition: color 0.25s;
  }
  .tracks a:hover .t { color: var(--accent); }
  time, .len {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--fg-faint);
    white-space: nowrap;
  }
  .len { text-align: right; font-variant-numeric: tabular-nums; }
  .stamp { margin-left: 0.6rem; vertical-align: middle; }
  @media (max-width: 640px) {
    .tracks a { grid-template-columns: 2.4rem minmax(0, 1fr) auto; gap: 0.25rem 0.8rem; }
    .t { grid-column: 2 / -1; }
    time { grid-column: 2; }
    .len { grid-column: 3; }
  }
</style>
