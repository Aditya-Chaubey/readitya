---
import { render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import Title from '../../components/Title.astro';
import { formatDate, getWritings, readingTime, wordCount, type Writing } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = await getWritings();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Writing;
  newer?: Writing;
  older?: Writing;
}
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const words = wordCount(post.body);
const toc = headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.slug !== 'footnote-label');
const showToc = post.data.toc && toc.filter((h) => h.depth === 2).length >= 2;
---

<Page title={post.data.title} description={post.data.description} section="Writings" type="article" progress>
  <header class="hero">
    <p class="meta-row">
      <span class="stamp">{post.data.type}</span>
      {post.data.draft && <span class="stamp">draft</span>}
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <span class="sep">/</span>
      <span>{words.toLocaleString('en')} words</span>
      <span class="sep">/</span>
      <span>{readingTime(words)} min</span>
    </p>
    <Title text={post.data.title} class="headline" />
    {post.data.description && <p class="dek">{post.data.description}</p>}
    {
      post.data.tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {post.data.tags.map((t) => <li>#{t}</li>)}
        </ul>
      )
    }
  </header>

  <div class:list={['layout', { 'has-toc': showToc }]}>
    <article class="prose">
      <Content />
      {
        post.data.updated && (
          <p class="revised">
            Revised <time datetime={post.data.updated.toISOString()}>{formatDate(post.data.updated)}</time>
          </p>
        )
      }
    </article>

    {
      showToc && (
        <nav class="toc" aria-label="Contents">
          <p class="label">Contents</p>
          <ol>
            {toc.map((h) => (
              <li class={`d${h.depth}`}>
                <a href={`#${h.slug}`} data-slug={h.slug}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
  </div>

  {
    (older || newer) && (
      <nav class="pager" aria-label="More writings">
        {older ? (
          <a href={`/writings/${older.id}/`}>
            <span class="label">← Previous</span>
            <span class="pt">{older.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {newer ? (
          <a class="nx" href={`/writings/${newer.id}/`}>
            <span class="label">Next →</span>
            <span class="pt">{newer.data.title}</span>
          </a>
        ) : (
          <span />
        )}
      </nav>
    )
  }
</Page>

<script>
  // highlight the section you're reading in the side contents
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a[data-slug]')];
  if (links.length && 'IntersectionObserver' in window) {
    const bySlug = new Map(links.map((a) => [a.dataset.slug!, a]));
    const headings = links.map((a) => document.getElementById(a.dataset.slug!)).filter(Boolean) as HTMLElement[];
    let current = '';
    const io = new IntersectionObserver(
      () => {
        // the last heading above the reading line wins
        const line = innerHeight * 0.3;
        let id = headings[0]?.id ?? '';
        for (const h of headings) if (h.getBoundingClientRect().top < line) id = h.id;
        if (id === current) return;
        current = id;
        links.forEach((a) => a.classList.toggle('on', a.dataset.slug === id));
      },
      { rootMargin: '0px 0px -60% 0px', threshold: [0, 1] },
    );
    headings.forEach((h) => io.observe(h));
    bySlug.get(headings[0]?.id ?? '')?.classList.add('on');
  }
</script>

<style>
  .hero :global(.headline) { max-width: 18ch; }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    list-style: none;
    padding: 0;
    margin-top: 1.25rem;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    color: var(--fg-faint);
  }

  .layout { display: grid; grid-template-columns: minmax(0, 1fr); }
  .layout.has-toc { grid-template-columns: minmax(0, var(--read)) minmax(11rem, 15rem); justify-content: space-between; gap: 4rem; }
  .prose { font-size: 1.1em; }

  .toc { position: sticky; top: calc(var(--head-h) + 2rem); align-self: start; }
  .toc .label { margin-bottom: 0.8rem; }
  .toc ol { list-style: none; padding: 0; border-left: 1px solid var(--line); }
  .toc li { margin: 0; }
  .toc a {
    display: block;
    padding: 0.35rem 0 0.35rem 1rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-family: var(--font-head);
    font-size: 0.85rem;
    line-height: 1.35;
    text-decoration: none;
    color: var(--fg-faint);
    transition: color 0.25s, border-color 0.25s;
  }
  .toc .d3 a { padding-left: 1.9rem; font-size: 0.8rem; }
  .toc a:hover { color: var(--fg); }
  .toc a.on { color: var(--fg); border-left-color: var(--sec); }

  .revised { margin-top: 2.5rem; font-family: var(--font-ui); font-size: 0.72rem; color: var(--fg-faint); }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: clamp(3rem, 8vh, 5rem);
  }
  .pager a {
    display: grid;
    gap: 0.4rem;
    padding: 1.25rem 1.4rem;
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition: transform 0.35s var(--ease-out), background-color 0.25s;
  }
  .pager a:hover { transform: translateY(-3px); background: color-mix(in srgb, var(--sec) 14%, var(--surface)); }
  .pager .nx { text-align: right; grid-column: 2; }
  .pt { font-family: var(--font-head); font-weight: 650; font-size: 1.15rem; line-height: 1.25; }

  @media (max-width: 1080px) {
    .layout.has-toc { grid-template-columns: minmax(0, 1fr); }
    .toc { display: none; }
  }
  @media (max-width: 560px) {
    .pager { grid-template-columns: 1fr; }
    .pager .nx { grid-column: 1; }
  }
</style>
