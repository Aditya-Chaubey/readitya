---
import { render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import Title from '../../components/Title.astro';
import { formatDate, getWritings, readingTime, wordCount, type Writing } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = await getWritings();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Writing;
  newer?: Writing;
  older?: Writing;
}
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const minutes = readingTime(wordCount(post.body));
const toc = headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.slug !== 'footnote-label');
const showToc = post.data.toc && toc.filter((h) => h.depth === 2).length >= 2;
---

<Page title={post.data.title} description={post.data.description} section="Writings" type="article" progress>
  <div class="content">
    <header class="post-head">
      <p class="meta">
        <span class="stamp">{post.data.type}</span>
        {post.data.draft && <span class="stamp draft">draft</span>}
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
      </p>
      <Title text={post.data.title} />
      {post.data.description && <p class="dek">{post.data.description}</p>}
      <hr class="title-rule" />
      {
        post.data.tags.length > 0 && (
          <ul class="tags" aria-label="Tags">
            {post.data.tags.map((t) => <li>#{t}</li>)}
          </ul>
        )
      }
    </header>

    {
      showToc && (
        <details class="toc" open>
          <summary>Contents</summary>
          <ol>
            {toc.map((h) => (
              <li class={`d${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )
    }

    <div class="prose dropcap">
      <Content />
    </div>

    {
      post.data.updated && (
        <p class="revised">
          Revised <time datetime={post.data.updated.toISOString()}>{formatDate(post.data.updated)}</time>
        </p>
      )
    }

    {
      (older || newer) && (
        <nav class="pager" aria-label="More writings">
          {older ? (
            <a href={`/writings/${older.id}/`}>
              <span class="eyebrow">← Previous</span>
              <span class="pt">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {newer ? (
            <a class="nx" href={`/writings/${newer.id}/`}>
              <span class="eyebrow">Next →</span>
              <span class="pt">{newer.data.title}</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </div>
</Page>

<style>
  .post-head { margin-bottom: 2.75rem; animation: none; }
  .post-head :global(h1) {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    line-height: 1.06;
    letter-spacing: -0.005em;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.7rem;
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-faint);
    animation: ink-in 0.8s var(--ease-out) both;
  }
  .meta .stamp { margin-right: 0.3rem; }
  .stamp.draft { color: var(--teal); }
  .dek {
    margin-top: 0.9rem;
    font-style: italic;
    font-size: 1.18em;
    color: var(--ink-soft);
    text-wrap: pretty;
    animation: ink-in 0.9s var(--ease-out) both 0.3s;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    list-style: none;
    padding: 0;
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-faint);
  }

  .toc { margin: 0 0 2.75rem; padding-left: 1.1rem; border-left: 2px solid var(--rule); }
  .toc summary {
    cursor: pointer;
    list-style: none;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.14em;
    color: var(--ink-faint);
  }
  .toc summary::-webkit-details-marker { display: none; }
  .toc summary::after { content: ' +'; }
  .toc[open] summary::after { content: ' –'; }
  .toc ol { list-style: none; padding: 0; margin-top: 0.4rem; counter-reset: ch; }
  .toc li { display: flex; gap: 0.6rem; padding: 0.12rem 0; }
  .toc li.d2 { counter-increment: ch; }
  .toc li.d2::before {
    content: counter(ch, upper-roman) '.';
    font-family: var(--font-display);
    color: var(--accent);
    min-width: 2rem;
  }
  .toc li.d3 { padding-left: 2.6rem; font-size: 0.95em; font-style: italic; }
  .toc a { text-decoration: none; color: var(--ink-soft); transition: color 0.2s; }
  .toc a:hover { color: var(--accent); }

  .revised { margin-top: 2.5rem; font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-faint); }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
  }
  .pager a {
    display: grid;
    gap: 0.25rem;
    color: inherit;
    text-decoration: none;
  }
  .pager .nx { text-align: right; grid-column: 2; }
  .pt {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.25;
    transition: color 0.2s;
  }
  .pager a:hover .pt { color: var(--accent); }
  @media (max-width: 520px) {
    .pager { grid-template-columns: 1fr; }
    .pager .nx { grid-column: 1; }
  }
</style>
