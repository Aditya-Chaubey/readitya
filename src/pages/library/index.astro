---
import Page from '../../layouts/Page.astro';
import { getShelves, hash } from '../../lib/utils';
import Title from '../../components/Title.astro';

const shelves = await getShelves();

// each shelf is a book; vary the sizes a little (stable per shelf) so it looks lived-in
const books = shelves.map((s, i) => {
  const h = hash(s.id);
  return {
    shelf: s,
    i,
    w: 46 + (h % 5) * 4, // spine thickness
    ht: 168 + ((h >>> 4) % 6) * 9, // height
  };
});
// seven books per shelf; the last shelf also gets a little stack of books lying flat
const PER_ROW = 7;
const rows: (typeof books)[] = [];
for (let i = 0; i < books.length; i += PER_ROW) rows.push(books.slice(i, i + PER_ROW));
if (rows.length === 0) rows.push([]);
const showStack = rows[rows.length - 1].length <= PER_ROW - 1;
const stack = [
  { len: 132, th: 17, c: '#5c3f27' },
  { len: 118, th: 22, c: '#2c4a55' },
  { len: 126, th: 15, c: '#8a2f25' },
];
---

<Page title="Library" section="Library" description="A catalogue of the books, films, shows, music and more that I have consumed.">
  <div class="content">
    <header class="page-title">
      <Title text="Library" />
      <p class="lede">Everything I've read, watched and listened to.</p>
      <hr class="title-rule" />
    </header>

    <div class="bookcase" role="list" aria-label="Shelves">
      {
        rows.map((row, r) => (
          <div class="shelf">
            <div class="books">
              {row.map((b) => (
                <a
                  class="vol"
                  role="listitem"
                  href={`/library/${b.shelf.id}/`}
                  style={`--c:${b.shelf.data.color};--w:${b.w};--h:${b.ht};--i:${b.i}`}
                  aria-label={`${b.shelf.data.title} — ${b.shelf.data.items.length} entries`}
                >
                  <span class="f spine">
                    <span class="band" aria-hidden="true" />
                    <span class="title">{b.shelf.data.title}</span>
                    <span class="band" aria-hidden="true" />
                    <span class="call" aria-hidden="true">{b.shelf.data.items.length}</span>
                  </span>
                  <span class="f top" aria-hidden="true" />
                  <span class="f side left" aria-hidden="true" />
                  <span class="f side right" aria-hidden="true" />
                </a>
              ))}
              {r === rows.length - 1 && showStack && (
                <span class="stack" aria-hidden="true">
                  {stack.map((b) => (
                    <span class="flat" style={`--c:${b.c};--len:${b.len};--th:${b.th}`}>
                      <span class="f fspine" />
                      <span class="f ftop" />
                      <span class="f fend left" />
                      <span class="f fend right" />
                    </span>
                  ))}
                </span>
              )}
            </div>
            <div class="ledge" aria-hidden="true"><span class="ledge-top" /><span class="ledge-front" /></div>
          </div>
        ))
      }
    </div>

  </div>
</Page>

<style>
  /* ══ The bookcase ══════════════════════════════════════════
     Each book is a real box in 3D: spine (front), page block (top),
     and both covers (sides). The shelf is seen from a little above,
     so you can see the tops of the books and the shelf surface. */
  .bookcase {
    --k: 1; /* size scale */
    --depth: calc(118px * var(--k));
    margin: 1rem 0 2.5rem;
    padding: 18px 14px 0;
    border-radius: 4px 4px 2px 2px;
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgb(255 230 180 / 0.12), transparent 70%),
      linear-gradient(180deg, rgb(var(--shadow) / 0.2), rgb(var(--shadow) / 0.07));
    box-shadow: inset 0 14px 22px -14px rgb(var(--shadow) / 0.6), inset 10px 0 18px -14px rgb(var(--shadow) / 0.4), inset -10px 0 18px -14px rgb(var(--shadow) / 0.4);
  }
  :global(:root[data-theme='dark']) .bookcase {
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgb(255 170 90 / 0.08), transparent 70%),
      linear-gradient(180deg, rgb(0 0 0 / 0.45), rgb(0 0 0 / 0.2));
    box-shadow: inset 0 16px 26px -12px #000, inset 10px 0 18px -14px #000, inset -10px 0 18px -14px #000;
  }
  .shelf {
    perspective: 1100px;
    perspective-origin: 50% -60%;
  }
  .shelf + .shelf { margin-top: 26px; }
  .books {
    display: flex;
    align-items: flex-end;
    gap: calc(7px * var(--k));
    height: calc(236px * var(--k));
    padding: 0 calc(18px * var(--k));
    transform-style: preserve-3d;
    /* Firefox hit-tests this flat layer in front of books pushed back in 3D, so let clicks pass through it */
    pointer-events: none;
  }

  .vol {
    pointer-events: auto;
    position: relative;
    flex: none;
    width: calc(var(--w) * 1px * var(--k));
    height: calc(var(--h) * 1px * var(--k));
    text-decoration: none;
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--depth) * -0.08));
    transition: transform 0.6s var(--ease-spring);
    animation: book-in 0.9s var(--ease-spring) backwards;
    animation-delay: calc(var(--i) * 80ms + 0.25s);
    outline: none;
  }
  @keyframes book-in { from { transform: translateY(-60px) translateZ(-20px) rotateZ(-5deg); opacity: 0; } }
  .vol:hover, .vol:focus-visible {
    transform: translateZ(calc(var(--depth) * 0.42)) translateY(-8px) rotateX(-6deg) rotateY(-4deg);
  }
  .vol:nth-child(4n + 2):not(:hover):not(:focus-visible) { transform: translateZ(calc(var(--depth) * -0.14)); }
  .vol:nth-child(5n + 3):not(:hover):not(:focus-visible) { transform: translateZ(calc(var(--depth) * -0.02)); }
  .f { position: absolute; display: block; }

  /* spine — cloth-bound, rounded, with gilt bands */
  .spine {
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: calc(14px * var(--k)) 0 calc(10px * var(--k));
    border-radius: 3px 3px 2px 2px;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.5), rgb(0 0 0 / 0.1) 9%, rgb(255 255 255 / 0.2) 24%, rgb(255 255 255 / 0.06) 42%, rgb(0 0 0 / 0.06) 66%, rgb(0 0 0 / 0.42) 92%, rgb(0 0 0 / 0.6)),
      repeating-linear-gradient(45deg, rgb(255 255 255 / 0.035) 0 1px, transparent 1px 3px),
      repeating-linear-gradient(-45deg, rgb(0 0 0 / 0.04) 0 1px, transparent 1px 3px),
      var(--c);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.2), inset 0 -2px 3px rgb(0 0 0 / 0.3);
    transition: box-shadow 0.4s;
  }
  .vol:hover .spine, .vol:focus-visible .spine { box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.25), 0 26px 30px -14px rgb(0 0 0 / 0.55); }
  .band {
    width: 100%;
    height: calc(7px * var(--k));
    flex: none;
    background:
      linear-gradient(180deg, transparent 0 1px, #e8c46b 1px 2.5px, transparent 2.5px calc(100% - 2.5px), #e8c46b calc(100% - 2.5px) calc(100% - 1px), transparent calc(100% - 1px));
    opacity: 0.85;
  }
  .title {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    padding-block: calc(10px * var(--k));
    font-family: var(--font-display-sc);
    font-size: calc(1.05rem * var(--k));
    letter-spacing: 0.1em;
    white-space: nowrap;
    color: #f0d48a;
    text-shadow: 0 1px 0 rgb(0 0 0 / 0.55), 0 0 1px rgb(255 230 160 / 0.4);
  }
  .call {
    flex: none;
    margin-top: calc(8px * var(--k));
    min-width: 62%;
    padding: 2px 3px 1px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: calc(0.62rem * var(--k));
    color: #2a1f17;
    background: #f3ead6;
    border-radius: 1px;
    box-shadow: 0 1px 1px rgb(0 0 0 / 0.35);
  }

  /* page block on top, between the two cover boards */
  .top {
    left: 0;
    top: 0;
    width: 100%;
    height: var(--depth);
    transform-origin: top center;
    transform: rotateX(-90deg);
    background:
      linear-gradient(180deg, var(--c) 0 4px, rgb(0 0 0 / 0.25) 4px 5px, transparent 5px),
      linear-gradient(90deg, var(--c) 0 3px, transparent 3px calc(100% - 3px), var(--c) calc(100% - 3px)),
      repeating-linear-gradient(90deg, rgb(120 85 40 / 0.22) 0 1px, transparent 1px 2.5px),
      linear-gradient(180deg, #f6ecd5, #d4c29b);
  }
  :global(:root[data-theme='dark']) .top { filter: brightness(0.8); }
  /* covers on each side */
  .side {
    top: 0;
    width: var(--depth);
    height: 100%;
    transform-origin: left center;
    transform: rotateY(90deg);
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.28) 0 7px, rgb(255 255 255 / 0.06) 7px 8px, transparent 8px),
      linear-gradient(180deg, rgb(255 255 255 / 0.05), rgb(0 0 0 / 0.25)),
      linear-gradient(rgb(0 0 0 / 0.32), rgb(0 0 0 / 0.32)),
      var(--c);
    border-radius: 0 3px 3px 0;
  }
  .side.left { left: 0; }
  .side.right { left: 100%; }

  /* ── a small stack of books lying flat ── */
  .stack {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    margin-left: auto;
    margin-right: calc(10px * var(--k));
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--depth) * -0.1));
  }
  .flat {
    position: relative;
    width: calc(var(--len) * 1px * var(--k));
    height: calc(var(--th) * 1px * var(--k));
    transform-style: preserve-3d;
  }
  .flat:nth-child(2) { transform: translateX(calc(-6px * var(--k))) rotateY(-4deg); }
  .flat:nth-child(3) { transform: translateX(calc(5px * var(--k))) rotateY(5deg); }
  .fspine {
    inset: 0;
    border-radius: 2px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.18), rgb(255 255 255 / 0.04) 35%, rgb(0 0 0 / 0.35)),
      linear-gradient(90deg, transparent 10%, #e8c46b 10% calc(10% + 1.5px), transparent calc(10% + 1.5px) calc(90% - 1.5px), #e8c46b calc(90% - 1.5px) 90%, transparent 90%),
      var(--c);
  }
  .ftop {
    left: 0;
    top: 0;
    width: 100%;
    height: calc(var(--depth) * 0.72);
    transform-origin: top center;
    transform: rotateX(-90deg);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.1), rgb(0 0 0 / 0.15)), var(--c);
    border-radius: 0 0 3px 3px;
  }
  .fend {
    top: 0;
    width: calc(var(--depth) * 0.72);
    height: 100%;
    transform-origin: left center;
    transform: rotateY(90deg);
    background:
      linear-gradient(180deg, var(--c) 0 2px, transparent 2px calc(100% - 2px), var(--c) calc(100% - 2px)),
      repeating-linear-gradient(180deg, rgb(120 85 40 / 0.25) 0 1px, transparent 1px 2.5px),
      linear-gradient(90deg, #e9dcbc, #cdb98f);
  }
  .fend.left { left: 0; }
  .fend.right { left: 100%; }

  /* ── the shelf board ── */
  .ledge { position: relative; z-index: 1; }
  .ledge-top {
    display: block;
    height: calc(20px * var(--k));
    margin-inline: -14px;
    clip-path: polygon(2% 0, 98% 0, 100% 100%, 0 100%);
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.35), transparent 45%),
      repeating-linear-gradient(90deg, rgb(0 0 0 / 0.06) 0 2px, transparent 2px 11px, rgb(255 255 255 / 0.05) 11px 12px, transparent 12px 27px),
      linear-gradient(180deg, #8c5c37, #a87447);
  }
  .ledge-front {
    display: block;
    height: calc(16px * var(--k));
    margin-inline: -14px;
    border-radius: 0 0 2px 2px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.22) 0 1px, transparent 1px 30%, rgb(0 0 0 / 0.2)),
      repeating-linear-gradient(90deg, rgb(0 0 0 / 0.07) 0 3px, transparent 3px 14px),
      #6a4024;
    box-shadow: 0 12px 16px -8px rgb(0 0 0 / 0.5);
  }
  :global(:root[data-theme='dark']) .ledge-top { filter: brightness(0.62); }
  :global(:root[data-theme='dark']) .ledge-front { filter: brightness(0.6); }

  @media (max-width: 600px) {
    .bookcase { --k: 0.74; padding-inline: 8px; }
    .stack { display: none; }
    .ledge-top, .ledge-front { margin-inline: -8px; }
  }
  @media (max-width: 380px) {
    .bookcase { --k: 0.64; }
  }

</style>
