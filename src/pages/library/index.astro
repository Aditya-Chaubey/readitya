---
import Page from '../../layouts/Page.astro';
import SectionHead from '../../components/SectionHead.astro';
import { getShelves } from '../../lib/utils';

const shelves = await getShelves();
const total = shelves.reduce((n, s) => n + s.data.items.length, 0);
/** "C-60" style tape length from how many entries a shelf holds */
const tapeLen = (n: number) => `C-${Math.min(120, Math.max(30, Math.ceil(n / 5) * 30))}`;
const first = shelves[0];
---

<Page title="Library" section="Library" description="A catalogue of the books, films, shows, music and more that I have consumed.">
  <SectionHead section="Library" lede="Everything I've read, watched and listened to — one tape per shelf. Pull one out." count={total} />

  <div class="library">
    <!-- a tower of cassette cases, spines out -->
    <div class="tower">
      <div class="rack" role="list" aria-label="Shelves">
        {
          shelves.map((s, i) => (
            <a
              class="case"
              role="listitem"
              href={`/library/${s.id}/`}
              style={`--c:${s.data.color};--i:${i}`}
              data-title={s.data.title}
              data-desc={s.data.description ?? ''}
              data-count={s.data.items.length}
              data-len={tapeLen(s.data.items.length)}
              aria-label={`${s.data.title} — ${s.data.items.length} entries`}
            >
              <span class="f spine">
                <span class="tab">{String(i + 1).padStart(2, '0')}</span>
                <span class="paper">
                  <span class="title">{s.data.title}</span>
                  <span class="meta">
                    {s.data.items.length} · {tapeLen(s.data.items.length)}
                  </span>
                </span>
                <span class="bars" aria-hidden="true"><i /><i /><i /></span>
              </span>
              <span class="f lid" aria-hidden="true">
                <svg viewBox="0 0 320 200" preserveAspectRatio="xMidYMid meet">
                  <rect x="20" y="10" width="280" height="180" rx="12" class="shell" />
                  <rect x="40" y="22" width="240" height="96" rx="6" class="lbl" />
                  <rect x="40" y="22" width="240" height="20" rx="6" class="lbl-band" />
                  <rect x="88" y="78" width="144" height="36" rx="18" class="win" />
                  <circle cx="122" cy="96" r="11" class="hub" />
                  <circle cx="198" cy="96" r="11" class="hub" />
                  <path d="M70 190 L84 150 H236 L250 190 Z" class="foot" />
                </svg>
              </span>
              <span class="f end" aria-hidden="true" />
            </a>
          ))
        }
      </div>
      <div class="plinth" aria-hidden="true"></div>
    </div>

    <!-- the J-card for whichever tape is pulled out -->
    {
      first && (
        <aside class="jcard" aria-live="polite">
          <span class="stripes" aria-hidden="true"><i /><i /><i /></span>
          <p class="label">Now selected</p>
          <h2 class="j-title" data-j="title">{first.data.title}</h2>
          <p class="j-desc" data-j="desc">{first.data.description}</p>
          <p class="j-meta">
            <span class="count" data-j="count">{String(first.data.items.length).padStart(3, '0')}</span>
            <span data-j="len">{tapeLen(first.data.items.length)}</span>
          </p>
          <a class="btn" href={`/library/${first.id}/`} data-j="href">▶ Play this tape</a>
        </aside>
      )
    }
  </div>
</Page>

<script>
  const card = document.querySelector<HTMLElement>('.jcard');
  const cases = document.querySelectorAll<HTMLAnchorElement>('.case');
  if (card) {
    const q = (k: string) => card.querySelector<HTMLElement>(`[data-j="${k}"]`)!;
    const show = (c: HTMLAnchorElement) => {
      const d = c.dataset;
      card.style.setProperty('--c', c.style.getPropertyValue('--c'));
      q('title').textContent = d.title ?? '';
      q('desc').textContent = d.desc ?? '';
      q('count').textContent = String(d.count ?? 0).padStart(3, '0');
      q('len').textContent = d.len ?? '';
      (q('href') as HTMLAnchorElement).href = c.href;
      card.classList.remove('swap');
      void card.offsetWidth;
      card.classList.add('swap');
    };
    cases.forEach((c) => {
      c.addEventListener('pointerenter', () => show(c));
      c.addEventListener('focus', () => show(c));
    });
    if (cases[0]) card.style.setProperty('--c', cases[0].style.getPropertyValue('--c'));
  }
</script>

<style>
  .library {
    display: grid;
    grid-template-columns: minmax(0, 36rem) minmax(16rem, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  /* ── the tower ── */
  .tower {
    --h: clamp(3rem, 6vw, 3.75rem);  /* thickness of one case (its spine) */
    --d: 210px;                      /* depth of a case, front to back */
    perspective: 1300px;
    perspective-origin: 30% -30%;
    padding: 14px 16px 0;
    border-radius: 16px 16px 0 0;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.25), transparent 6%, transparent 94%, rgb(0 0 0 / 0.25)),
      linear-gradient(180deg, #2a2624, #1b1817);
    box-shadow: inset 0 2px 0 rgb(255 255 255 / 0.08), 0 30px 50px -30px rgb(0 0 0 / 0.6);
  }
  .rack {
    display: grid;
    gap: 7px;
    padding-bottom: 14px;
    transform-style: preserve-3d;
    /* Firefox hit-tests this flat layer in front of the cases, so let clicks through */
    pointer-events: none;
  }
  .case {
    position: relative;
    display: block;
    height: var(--h);
    text-decoration: none;
    color: inherit;
    transform-style: preserve-3d;
    pointer-events: auto;
    transition: transform 0.6s var(--ease-spring);
    animation: slot-in 0.8s var(--ease-out) backwards;
    animation-delay: calc(var(--i) * 70ms + 0.2s);
    outline: none;
  }
  @keyframes slot-in { from { translate: 60px 0; opacity: 0; } }
  .case:hover, .case:focus-visible {
    transform: translateZ(70px) translateX(-10px) rotateX(-10deg);
  }
  .f { position: absolute; display: block; }

  /* the spine: a J-card strip seen through clear plastic */
  .spine {
    inset: 0;
    display: flex;
    align-items: stretch;
    border-radius: 4px;
    overflow: hidden;
    background: #efe6d2;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.25), 0 2px 0 rgb(0 0 0 / 0.35);
  }
  .spine::after {
    /* the plastic case's gloss */
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.45), rgb(255 255 255 / 0) 40%, rgb(0 0 0 / 0) 70%, rgb(0 0 0 / 0.12));
    pointer-events: none;
  }
  .tab {
    display: grid;
    place-items: center;
    flex: none;
    width: calc(var(--h) * 1.15);
    font-family: var(--font-head);
    font-weight: 900;
    font-stretch: 115%;
    font-size: calc(var(--h) * 0.38);
    color: #fff;
    background: var(--c);
  }
  .paper {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 1rem;
    background: repeating-linear-gradient(0deg, transparent 0 calc(var(--h) / 3 - 1px), rgb(31 43 85 / 0.08) calc(var(--h) / 3 - 1px) calc(var(--h) / 3));
  }
  .title {
    font-family: var(--font-hand);
    font-size: calc(var(--h) * 0.4);
    line-height: 1;
    color: #1f2b55;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .meta {
    flex: none;
    font-family: var(--font-ui);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    color: #6b5d4c;
  }
  .bars { display: flex; gap: 3px; padding: 0 0.6rem; flex: none; }
  .bars i { width: 4px; border-radius: 1px; }
  .bars i:nth-child(1) { background: var(--stripe-1); }
  .bars i:nth-child(2) { background: var(--stripe-2); }
  .bars i:nth-child(3) { background: var(--stripe-3); }

  /* the lid: clear plastic with the cassette inside, seen once the case slides out */
  .lid {
    left: 0;
    top: 0;
    width: 100%;
    height: var(--d);
    transform-origin: top center;
    transform: rotateX(-90deg);
    border-radius: 0 0 6px 6px;
    background:
      linear-gradient(160deg, rgb(255 255 255 / 0.22), rgb(255 255 255 / 0.04) 40%, rgb(255 255 255 / 0.1)),
      #3b3836;
    /* tucked under the case above until this one is pulled out */
    opacity: 0;
    transition: opacity 0.25s;
  }
  .case:hover .lid, .case:focus-visible .lid { opacity: 1; transition-delay: 0.05s; }
  .lid svg { width: 100%; height: 100%; display: block; }
  .shell { fill: var(--c); }
  .lbl { fill: #efe6d2; }
  .lbl-band { fill: color-mix(in srgb, var(--c) 60%, #000); }
  .win { fill: #15110e; }
  .hub { fill: #efe6d2; }
  .foot { fill: rgb(0 0 0 / 0.2); }
  /* the right-hand end of the case */
  .end {
    top: 0;
    left: 100%;
    width: var(--d);
    height: 100%;
    transform-origin: left center;
    transform: rotateY(90deg);
    background: linear-gradient(90deg, #4a4542, #2b2826);
    border-radius: 0 4px 4px 0;
  }
  .plinth {
    height: 16px;
    margin: 0 -16px;
    border-radius: 0 0 10px 10px;
    background: linear-gradient(180deg, #3a3532, #141211);
    box-shadow: 0 14px 24px -12px rgb(0 0 0 / 0.6);
  }

  /* ── the J-card info panel ── */
  .jcard {
    --c: var(--sec);
    position: sticky;
    top: calc(var(--head-h) + 2rem);
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem 1.6rem 1.6rem;
    border-radius: var(--radius);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--c) 18%, transparent), transparent 55%),
      var(--surface);
    transition: background-color 0.3s;
  }
  .jcard .stripes { width: 3.5rem; }
  .j-title {
    font-family: var(--font-hand);
    font-weight: 400;
    font-size: clamp(2rem, 3.4vw, 2.8rem);
    line-height: 1.05;
    color: var(--fg);
  }
  .j-desc { color: var(--fg-soft); line-height: 1.5; min-height: 3em; }
  .j-meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--fg-faint);
  }
  .j-meta .count {
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    background: var(--glass);
    color: var(--vfd);
    text-shadow: 0 0 5px var(--vfd-glow);
    font-weight: 700;
    letter-spacing: 0.15em;
  }
  .jcard .btn { justify-self: start; margin-top: 0.4rem; }
  .jcard.swap > :not(.stripes) { animation: swap-in 0.45s var(--ease-out); }
  @keyframes swap-in { from { opacity: 0; transform: translateY(6px); } }

  @media (max-width: 860px) {
    .library { grid-template-columns: minmax(0, 1fr); }
    .jcard { display: none; }
    .tower { --d: 150px; }
  }
</style>
