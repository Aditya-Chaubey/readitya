---
import Page from '../../layouts/Page.astro';
import Rating from '../../components/Rating.astro';
import Title from '../../components/Title.astro';
import { formatLoose, getShelves, looseKey, type Shelf } from '../../lib/utils';

export async function getStaticPaths() {
  const shelves = await getShelves();
  return shelves.map((shelf) => ({ params: { shelf: shelf.id }, props: { shelf } }));
}

interface Props {
  shelf: Shelf;
}
const { shelf } = Astro.props;
const { title, description, creatorLabel, verb, items } = shelf.data;

const rows = items
  .map((item) => {
    const last = item.logs.reduce((best, l) => {
      const k = looseKey(l.end ?? l.date);
      return k > best ? k : best;
    }, '');
    return { ...item, last };
  })
  .sort((a, b) => b.last.localeCompare(a.last) || a.title.localeCompare(b.title));
---

<Page title={title} description={description ?? `My ${title.toLowerCase()} log.`} section="Library">
  <header class="hero">
    <p class="display" aria-hidden="true">
      <span class="reels"><i></i><i></i></span>
      <span class="txt"><span class="dim">▶ Library ▸</span> <span class="lit">{title}</span></span>
      <span class="count">{String(rows.length).padStart(3, '0')}</span>
    </p>
    <Title text={title} class="headline" />
    {description && <p class="dek">{description}</p>}
    <p class="meta-row"><a class="stamp" href="/library">◀◀ Back to the tower</a></p>
  </header>

  {
    rows.length > 1 && (
      <form class="controls" aria-label="Sort and filter" onsubmit="return false">
        <label class="select">
          <span class="sr-only">Sort</span>
          <select name="sort">
            <option value="last:desc">{verb} — newest</option>
            <option value="last:asc">{verb} — oldest</option>
            <option value="rating:desc">Rating — high to low</option>
            <option value="rating:asc">Rating — low to high</option>
            <option value="year:desc">Released — newest</option>
            <option value="year:asc">Released — oldest</option>
            <option value="title:asc">Title — A to Z</option>
          </select>
        </label>
        <label class="chip">
          <input type="checkbox" name="notes" /> <span>With notes</span>
        </label>
        <label class="chip">
          <input type="checkbox" name="rated" /> <span>Rated</span>
        </label>
      </form>
    )
  }

  {rows.length === 0 && <p class="muted">Nothing here yet.</p>}

  <ol class="items" id="items">
    {
      rows.map((item) => (
        <li
          class="item reveal"
          data-title={item.title.toLowerCase()}
          data-year={String(item.year ?? '')}
          data-rating={String(item.rating ?? -1)}
          data-last={item.last}
          data-notes={item.notes ? '1' : '0'}
        >
          {item.cover && <img class="cover" src={item.cover} alt="" loading="lazy" width="96" height="144" />}
          <div class="body">
            <div class="top">
              <h2 class="t">{item.link ? <a href={item.link} rel="noopener">{item.title}</a> : item.title}</h2>
              {item.year && <span class="yr">{item.year}</span>}
            </div>
            {item.creator && (
              <p class="by">
                <span class="sr-only">{creatorLabel}: </span>
                {item.creator}
              </p>
            )}
            {item.rating !== undefined && (
              <p class="rate">
                <Rating value={item.rating} />
              </p>
            )}
            {item.notes && (
              <div class="notes">
                {item.notes.split(/\n\s*\n/).map((para) => <p>{para}</p>)}
              </div>
            )}
            {item.logs.length > 0 && (
              <ul class="logs" aria-label="Log">
                {item.logs.map((l) => (
                  <li>
                    <span>
                      {formatLoose(l.date)}
                      {l.end && <> → {formatLoose(l.end)}</>}
                    </span>
                    <span class="status">{l.status ?? verb}</span>
                  </li>
                ))}
              </ul>
            )}
            {item.tags.length > 0 && <p class="tags">{item.tags.map((t) => `#${t}`).join('  ')}</p>}
          </div>
        </li>
      ))
    }
  </ol>
  <p class="empty-filter muted" hidden>Nothing matches those filters.</p>
</Page>

<style>
  .hero :global(.headline) { max-width: 18ch; }
  .meta-row a.stamp { text-decoration: none; }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .controls select {
    font: inherit;
    text-transform: inherit;
    color: var(--fg);
    background: var(--surface);
    border: 0;
    border-radius: 99px;
    padding: 0.6rem 2.2rem 0.6rem 1rem;
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position: calc(100% - 1.15rem) 55%, calc(100% - 0.85rem) 55%;
    background-size: 5px 5px;
    background-repeat: no-repeat;
    cursor: pointer;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1rem;
    border-radius: 99px;
    background: var(--surface);
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .chip input { position: absolute; opacity: 0; pointer-events: none; }
  .chip:has(input:checked) { background: var(--sec); color: #fff; }
  .chip:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }

  .items {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: 1rem;
    counter-reset: item;
  }
  .item {
    counter-increment: item;
    position: relative;
    display: flex;
    gap: 1.1rem;
    padding: 1.35rem 1.4rem 1.4rem;
    border-radius: var(--radius);
    background: var(--surface);
    transition: transform 0.4s var(--ease-out), box-shadow 0.3s;
  }
  .item:hover { transform: translateY(-3px); box-shadow: 0 0 0 1.5px color-mix(in srgb, var(--sec) 60%, transparent); }
  .item::after {
    content: counter(item, decimal-leading-zero);
    position: absolute;
    top: 1.35rem;
    right: 1.4rem;
    font-family: var(--font-ui);
    font-size: 0.68rem;
    color: var(--fg-faint);
  }
  .cover { flex: none; width: 72px; height: 108px; object-fit: cover; border-radius: 6px; }
  .body { flex: 1; min-width: 0; display: grid; gap: 0.45rem; align-content: start; }
  .top { display: flex; align-items: baseline; gap: 0.6rem; padding-right: 2rem; }
  .t { font-family: var(--font-head); font-weight: 700; font-size: 1.25rem; line-height: 1.2; letter-spacing: -0.01em; }
  .t a { text-decoration: none; }
  .yr { font-family: var(--font-ui); font-size: 0.72rem; color: var(--fg-faint); }
  .by { color: var(--fg-soft); font-style: italic; }
  .notes { margin-top: 0.3rem; padding-left: 0.9rem; border-left: 2px solid var(--sec); color: var(--fg-soft); font-size: 0.98rem; line-height: 1.5; }
  .notes p + p { margin-top: 0.5em; }
  .logs { list-style: none; padding: 0; margin-top: 0.3rem; display: grid; gap: 0.25rem; font-family: var(--font-ui); font-size: 0.7rem; color: var(--fg-faint); }
  .logs li { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; }
  .status { text-transform: uppercase; letter-spacing: 0.06em; padding: 0.1em 0.5em; border-radius: 99px; background: color-mix(in srgb, var(--sec) 14%, transparent); color: var(--fg); }
  .tags { font-family: var(--font-ui); font-size: 0.7rem; color: var(--fg-faint); }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('.controls');
  const list = document.getElementById('items');
  const empty = document.querySelector<HTMLElement>('.empty-filter');

  if (form && list) {
    const items = Array.from(list.querySelectorAll<HTMLLIElement>('.item'));
    const apply = () => {
      const [key, dir] = (form.elements.namedItem('sort') as HTMLSelectElement).value.split(':');
      const onlyNotes = (form.elements.namedItem('notes') as HTMLInputElement).checked;
      const onlyRated = (form.elements.namedItem('rated') as HTMLInputElement).checked;
      const sign = dir === 'asc' ? 1 : -1;
      const val = (el: HTMLElement) => el.dataset[key] ?? '';
      const sorted = [...items].sort((a, b) => {
        if (key === 'rating') return sign * (Number(val(a)) - Number(val(b)));
        const A = val(a);
        const B = val(b);
        // keep blanks at the end regardless of direction
        if (!A && B) return 1;
        if (A && !B) return -1;
        return sign * A.localeCompare(B, undefined, { numeric: true });
      });
      let shown = 0;
      for (const el of sorted) {
        const hide = (onlyNotes && el.dataset.notes !== '1') || (onlyRated && Number(el.dataset.rating) < 0);
        el.hidden = hide;
        if (!hide) shown++;
        list.append(el);
      }
      if (empty) empty.hidden = shown > 0;
    };
    form.addEventListener('change', apply);
  }
</script>
