---
import Page from '../layouts/Page.astro';
import Title from '../components/Title.astro';
---

<Page title="Page not found" section="404" color="#d9532e">
  <div class="lost">
    <p class="display" aria-hidden="true">
      <span class="reels"><i></i><i></i></span>
      <span class="txt"><span class="dim">■ Stop ▸</span> <span class="lit">No signal</span></span>
      <span class="count">404</span>
    </p>
    <Title text="This side of the tape is blank." class="headline" />
    <p class="dek">Whatever was here has been taped over.</p>
    <p class="actions"><a class="btn" href="/">⏏ Back to the tapes</a></p>
  </div>
</Page>

<style>
  .lost { padding-block: clamp(2rem, 10vh, 6rem); }
  .lost :global(.headline) { max-width: 16ch; margin-top: 1rem; }
  .actions { margin-top: 2rem; }
</style>
