---
import Base from '../layouts/Base.astro';
import Cassette from '../components/Cassette.astro';
import Deck from '../components/Deck.astro';
import Title from '../components/Title.astro';
import { SITE, TAPES } from '../site.config';
---

<Base home>
  <main id="main" class="home">
    <header class="home-head">
      <p class="display" aria-hidden="true">
        <span class="reels"><i></i><i></i></span>
        <span class="txt"><span class="dim">Side A ▸</span> <span class="lit">Select a tape</span></span>
      </p>
      <Title text={SITE.author} class="home-title" />
      <p class="tagline">{SITE.tagline}</p>
    </header>

    <section class="rack" id="rack" aria-roledescription="carousel" aria-label="Choose a tape">
      <div class="stage">
        {
          TAPES.map((t, i) => (
            <a
              class="tape"
              href={t.href}
              data-index={i}
              data-label={t.label}
              data-side={t.side}
              data-length={t.length}
              data-note={t.note}
              data-shell={t.shell}
              data-band={t.band}
              data-ink={t.ink}
              aria-label={`${t.label} — tape ${i + 1} of ${TAPES.length}`}
              style={`--d:${i};--ad:${i};--n:${i};--shell:${t.shell};--band:${t.band}`}
            >
              <span class="tape-shadow" />
              <span class="tape-float">
                <span class="tape-body">
                  <span class="face front">
                    <Cassette id={`tape-${i}`} label={t.label} side={t.side} length={t.length} note={t.note} shell={t.shell} band={t.band} ink={t.ink} />
                    <span class="glare" />
                  </span>
                  <span class="core" />
                  <span class="back" />
                  <span class="edge e-top" />
                  <span class="edge e-bottom" />
                  <span class="edge e-left" />
                  <span class="edge e-right" />
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <div class="picker" aria-hidden="true">
      <span class="dots">{TAPES.map((_, i) => <button class="dot" type="button" tabindex="-1" data-go={i} />)}</span>
    </div>

    <div class="deck-wrap"><Deck /></div>

    <p class="hint" id="hint">scroll to choose · click to play</p>
    <nav class="plain-nav" aria-label="Sections">
      {TAPES.map((t) => <a href={t.href}>{t.label}</a>)}
    </nav>
  </main>

  <div class="tape-fx" aria-hidden="true"></div>
</Base>

<style>
  /* ── Room: the same calm surface as the rest of the site, with a soft pool of light behind the deck ── */
  :global(body.home) {
    background:
      radial-gradient(ellipse 60% 45% at 50% 65%, color-mix(in srgb, var(--stripe-1) 14%, transparent), transparent 70%),
      var(--bg);
  }

  .home {
    --sec: var(--stripe-2);
    --tw: clamp(150px, min(28vw, 28svh), 280px);
    --spread: clamp(125px, 23vw, 240px);
    position: relative;
    min-height: calc(100svh - var(--head-h));
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(1rem, 3vh, 2rem) 1rem 2rem;
  }

  .home-head { display: grid; justify-items: center; gap: 0.6rem; text-align: center; }
  .home-head .display { margin-bottom: 0.4rem; }
  .home-head :global(.home-title) {
    font-family: var(--font-head);
    font-weight: 900;
    font-stretch: 118%;
    font-size: clamp(2.2rem, 5.5vw, 3.6rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .tagline {
    font-style: italic;
    color: var(--fg-soft);
    animation: rise 0.9s var(--ease-out) both 0.45s;
  }

  /* ── Tape carousel, in real 3D ─────────────────────── */
  .rack {
    position: relative;
    width: 100%;
    height: calc(var(--tw) * 0.625 + 3rem);
    margin-top: clamp(0.25rem, 2vh, 1.5rem);
    perspective: 1000px;
    perspective-origin: 50% 35%;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  /* pointer-events: Firefox hit-tests this layer in front of tapes pushed back in 3D */
  .stage { position: absolute; inset: 0; transform-style: preserve-3d; pointer-events: none; }
  .stage .tape { pointer-events: auto; }
  .tape {
    --h: calc(var(--tw) * 0.625);
    --t: calc(var(--tw) * 0.07);
    position: absolute;
    left: 50%;
    top: 1.25rem;
    width: var(--tw);
    height: var(--h);
    margin-left: calc(var(--tw) / -2);
    display: block;
    text-decoration: none;
    transform-style: preserve-3d;
    transform:
      translateX(calc(var(--d) * var(--spread)))
      translateZ(calc(var(--ad) * -150px))
      rotateY(calc(var(--d) * -28deg));
    opacity: clamp(0, 1.5 - var(--ad) * 0.5, 1);
    z-index: calc(10 - var(--ad));
    transition: transform 0.75s var(--ease-out), opacity 0.5s;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    outline: none;
  }
  /* arrival: each tape drops into place, one after another */
  .tape { animation: tape-in 1.1s var(--ease-spring) backwards; animation-delay: calc(var(--n) * 90ms + 0.25s); }
  .tape .face, .tape .edge, .tape .core, .tape .back, .tape-shadow { animation: tape-fade 0.6s ease-out backwards; animation-delay: calc(var(--n) * 90ms + 0.25s); }
  @keyframes tape-in { from { translate: 0 -46px; } }
  @keyframes tape-fade { from { opacity: 0; } }
  .tape.far { opacity: 0; pointer-events: none; }
  .tape.warp, .rack.init .tape { transition: none; }
  .tape.gone { opacity: 0; transition: none; }

  .tape-float, .tape-body { position: absolute; inset: 0; transform-style: preserve-3d; }
  .tape-float { transition: transform 0.6s var(--ease-out); }
  .tape.is-active .tape-float { animation: sway 6s ease-in-out infinite; }
  .tape:not(.is-active):hover .tape-float { transform: translateY(-8px); }
  @keyframes sway {
    0%, 100% { transform: translateY(0) rotateY(-9deg) rotateX(4deg); }
    50% { transform: translateY(-9px) rotateY(9deg) rotateX(-2deg); }
  }
  .tape-body {
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.6s var(--ease-out);
  }
  .tape-body.tracking { transition: transform 0.1s linear; }

  /* A cassette is a moulded box: front & back plates, a solid core so no
     gaps ever show at the rounded corners, and four rounded plastic edges. */
  .face { position: absolute; inset: 0; backface-visibility: hidden; }
  .front { transform: translateZ(calc(var(--t) / 2)); }
  .front :global(svg) { display: block; }
  .core, .back {
    position: absolute;
    inset: 1.2% 1%;
    border-radius: 4.4% / 7%;
  }
  .core {
    transform: translateZ(0);
    background: color-mix(in srgb, var(--shell) 70%, #000);
  }
  .back {
    transform: translateZ(calc(var(--t) / -2));
    background:
      radial-gradient(circle at 30% 55%, rgb(0 0 0 / 0.3) 0 9%, transparent 9.5%),
      radial-gradient(circle at 70% 55%, rgb(0 0 0 / 0.3) 0 9%, transparent 9.5%),
      linear-gradient(color-mix(in srgb, var(--shell) 82%, #000), color-mix(in srgb, var(--shell) 66%, #000));
  }
  .edge {
    position: absolute;
    /* rounded moulded profile: dark at both rims, catching light in the middle, with the shell seam */
    --rim: color-mix(in srgb, var(--shell) 62%, #000);
    --mid: color-mix(in srgb, var(--shell) 90%, #fff);
    --seam: color-mix(in srgb, var(--shell) 45%, #000);
  }
  .e-top, .e-bottom { left: 3.4%; right: 3.4%; height: var(--t); }
  .e-left, .e-right { top: 5.5%; bottom: 5.5%; width: var(--t); }
  .e-top, .e-bottom {
    background: linear-gradient(180deg, var(--rim), var(--mid) 30%, var(--mid) 46%, var(--seam) 48% 52%, var(--mid) 54%, color-mix(in srgb, var(--shell) 80%, #000) 80%, var(--rim));
    border-radius: 3px;
  }
  .e-top { top: calc(1.2% - var(--t) / 2); transform: rotateX(90deg); }
  .e-bottom {
    bottom: calc(1.2% - var(--t) / 2);
    transform: rotateX(90deg);
    background:
      linear-gradient(90deg, transparent 24%, rgb(0 0 0 / 0.6) 24% 31%, transparent 31% 46.5%, rgb(0 0 0 / 0.6) 46.5% 53.5%, transparent 53.5% 69%, rgb(0 0 0 / 0.6) 69% 76%, transparent 76%) center / 100% 40% no-repeat,
      linear-gradient(180deg, var(--rim), color-mix(in srgb, var(--shell) 78%, #000) 40%, color-mix(in srgb, var(--shell) 72%, #000) 60%, var(--rim));
  }
  .e-left, .e-right {
    background: linear-gradient(90deg, var(--rim), var(--mid) 30%, var(--mid) 46%, var(--seam) 48% 52%, color-mix(in srgb, var(--shell) 85%, #000) 54%, color-mix(in srgb, var(--shell) 74%, #000) 80%, var(--rim));
    border-radius: 3px;
  }
  .e-left { left: calc(1% - var(--t) / 2); transform: rotateY(90deg); }
  .e-right { right: calc(1% - var(--t) / 2); transform: rotateY(-90deg); }
  /* tapes further back sit in shadow */
  .face, .edge, .core, .back { filter: brightness(calc(1 - var(--ad) * 0.12)) saturate(calc(1 - var(--ad) * 0.15)); transition: filter 0.6s; }

  .glare {
    position: absolute;
    inset: 1.5% 1%;
    border-radius: 4.4% / 7%;
    pointer-events: none;
    background:
      radial-gradient(circle at var(--gx, 30%) var(--gy, 20%), rgb(255 255 255 / 0.55), rgb(255 255 255 / 0) 45%),
      linear-gradient(115deg, transparent 35%, rgb(255 255 255 / 0.12) 45%, transparent 55%);
    mix-blend-mode: soft-light;
    opacity: 0;
    transition: opacity 0.4s;
  }
  .tape.is-active .glare { opacity: 1; }

  .tape-shadow {
    position: absolute;
    left: 10%;
    right: 10%;
    top: calc(100% + 6px);
    height: 26px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgb(40 18 4 / 0.4), transparent 70%);
    transform: translateZ(-30px);
    opacity: calc(1 - var(--ad) * 0.5);
  }
  :global(:root[data-theme='dark']) .tape-shadow { background: radial-gradient(ellipse at center, rgb(0 0 0 / 0.75), transparent 70%); }
  .tape.is-active .tape-shadow { animation: shadow-sway 6s ease-in-out infinite; }
  @keyframes shadow-sway { 50% { transform: translateZ(-30px) scale(0.84); opacity: 0.7; } }

  .tape:focus-visible .tape-body { outline: 2px dashed var(--accent); outline-offset: 10px; border-radius: 14px; }

  /* ── Picker / hints ─────────────────────────────── */
  .picker {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0.25rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .dots { display: inline-flex; gap: 7px; }
  .dot {
    width: 8px; height: 8px; padding: 0;
    border-radius: 50%;
    border: 1px solid var(--ink-faint);
    background: transparent;
    cursor: pointer;
    transition: background 0.2s, transform 0.3s var(--ease-spring), box-shadow 0.3s;
  }
  .dot.on { background: var(--accent); border-color: var(--accent); transform: scale(1.3); box-shadow: 0 0 8px var(--glow); }

  .deck-wrap {
    margin-top: clamp(2.25rem, 5vh, 3.25rem);
    width: min(100%, 780px, calc(62svh + 280px));
    animation: deck-in 1s var(--ease-out) both 0.15s;
  }
  @keyframes deck-in { from { opacity: 0; transform: translateY(30px); } }

  .hint {
    margin-top: 1.6rem;
    text-transform: uppercase;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    text-align: center;
    transition: opacity 0.8s, transform 0.8s var(--ease-out);
  }
  .hint.done { opacity: 0; transform: translateY(-4px); }
  .k {
    display: inline-block;
    padding: 0 0.4em;
    margin-inline: 0.1em;
    border: 1px solid var(--rule);
    border-bottom-width: 2px;
    border-radius: 3px;
    background: var(--paper);
    color: var(--ink-soft);
  }
  .plain-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.2rem 1.4rem;
    margin-top: 0.4rem;
  }
  .plain-nav a {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-faint);
    text-decoration: none;
    transition: color 0.2s;
  }
  .plain-nav a:hover { color: var(--accent); }

  /* ── Flight & transition effects (elements created by JS) ── */
  :global(.tape-ghost) {
    position: fixed;
    z-index: 50;
    pointer-events: none;
    transform-origin: 0 0;
    filter: drop-shadow(0 22px 18px rgb(30 12 2 / 0.4));
    will-change: transform, opacity;
  }
  .tape-fx {
    position: fixed;
    inset: 0;
    z-index: 90;
    pointer-events: none;
    opacity: 0;
    background:
      repeating-linear-gradient(0deg, rgb(0 0 0 / 0.08) 0 2px, transparent 2px 4px),
      var(--paper);
  }
  :global(html.leaving) .tape-fx { animation: fx-in 0.5s ease-in forwards; }
  :global(html.leaving) .home { animation: warble 0.5s ease-in forwards; }
  @keyframes fx-in {
    0% { opacity: 0; transform: translateY(0); }
    30% { opacity: 0.3; transform: translateY(-6px) skewX(-2deg); }
    55% { opacity: 0.55; transform: translateY(4px) skewX(1deg); }
    100% { opacity: 1; transform: none; }
  }
  @keyframes warble {
    30% { filter: blur(0.5px) hue-rotate(-8deg); transform: translateX(-3px); }
    60% { filter: blur(1.5px) hue-rotate(6deg); transform: translateX(2px) scaleY(1.01); }
    100% { filter: blur(3px); transform: scale(0.98); }
  }

  @media (max-width: 680px) {
    .home { --tw: clamp(170px, 52vw, 240px); --spread: clamp(95px, 33vw, 160px); }
    .hint { display: none; }
  }
  @media (max-height: 820px) and (min-width: 681px) {
    .home-head :global(.home-title) { font-size: 2.4rem; }
    .home-head .display { display: none; }
    .deck-wrap { margin-top: 2.25rem; }
    .hint { margin-top: 0.9rem; }
  }
</style>

<script>
  const root = document.documentElement;
  const tapes = Array.from(document.querySelectorAll<HTMLAnchorElement>('.stage .tape'));
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.picker .dot'));
  const rack = document.getElementById('rack')!;
  const deck = document.getElementById('deck')!;
  const door = document.getElementById('door')!;
  const slot = document.getElementById('door-slot')!;
  const win = document.getElementById('door-window')!;
  const deckTape = slot.querySelector<SVGSVGElement>('svg')!;
  const lcd = document.getElementById('lcd-text')!;
  const counterEl = document.getElementById('counter')!;
  const knob = document.getElementById('knob')!;
  const hint = document.getElementById('hint');
  const soundBtn = document.getElementById('sound-toggle') as HTMLButtonElement;
  const keys = Object.fromEntries(
    Array.from(deck.querySelectorAll<HTMLButtonElement>('.key')).map((k) => [k.dataset.act!, k]),
  );

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const n = tapes.length;
  const pad = (v: number, len = 2) => String(v).padStart(len, '0');
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const store = {
    get: (k: string) => { try { return sessionStorage.getItem(k) ?? localStorage.getItem(k); } catch { return null; } },
    set: (k: string, v: string, local = false) => { try { (local ? localStorage : sessionStorage).setItem(k, v); } catch {} },
  };

  let active = 0;
  let busy = false;
  let loaded = false;
  let counter = 0;
  let counterTimer: number | undefined;
  let lcdTimer: number | undefined;

  const saved = Number(store.get('tape'));
  if (Number.isInteger(saved) && saved >= 0 && saved < n) active = saved;

  /* ── Sound: tiny synthesised mechanical noises (no audio files) ── */
  let soundOn = store.get('deck-sound') !== 'off';
  let actx: AudioContext | undefined;
  function noise(dur: number, freq: number, gain: number, type: BiquadFilterType = 'bandpass', q = 1) {
    if (!soundOn) return;
    try {
      actx ??= new AudioContext();
      if (actx.state === 'suspended') actx.resume();
      const len = Math.max(1, Math.floor(actx.sampleRate * dur));
      const buf = actx.createBuffer(1, len, actx.sampleRate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < len; i++) data[i] = (Math.random() * 2 - 1) * (1 - i / len) ** 3;
      const src = actx.createBufferSource();
      src.buffer = buf;
      const f = actx.createBiquadFilter();
      f.type = type;
      f.frequency.value = freq;
      f.Q.value = q;
      const g = actx.createGain();
      g.gain.value = gain;
      src.connect(f).connect(g).connect(actx.destination);
      src.start();
    } catch {}
  }
  const sfx = {
    key: () => { noise(0.03, 2600, 0.16); noise(0.05, 500, 0.12, 'lowpass'); },
    clack: () => { noise(0.06, 1100, 0.22, 'bandpass', 0.7); },
    clunk: () => { noise(0.12, 260, 0.5, 'lowpass'); noise(0.025, 2000, 0.1); },
    hiss: () => { noise(0.9, 5000, 0.035, 'highpass'); },
    slide: () => { noise(0.35, 1400, 0.05, 'bandpass', 0.6); },
  };
  function setSound(on: boolean) {
    soundOn = on;
    soundBtn.setAttribute('aria-pressed', String(on));
    store.set('deck-sound', on ? 'on' : 'off', true);
  }
  soundBtn.addEventListener('click', () => { setSound(!soundOn); sfx.key(); });
  setSound(soundOn);

  /* ── Display ── */
  function setLcd(text: string, revertMs = 0) {
    lcd.textContent = text;
    clearTimeout(lcdTimer);
    if (revertMs) lcdTimer = window.setTimeout(() => setLcd(idleText()), revertMs);
  }
  const idleText = () => (loaded ? `■ Stop · ${tapes[active].dataset.label}` : `Select ▸ ${tapes[active].dataset.label}`);

  /* ── Carousel ── */
  /** Carousel slot of tape i: -1, 0, 1 are visible; ±2 is parked off-stage. Loops around. */
  function offsetFor(i: number, prev: number) {
    const raw = (((i - active) % n) + n) % n;
    const visible = [raw, raw - n].find((c) => Math.abs(c) <= 1);
    if (visible !== undefined) return visible;
    return prev < 0 ? -2 : 2;
  }
  function place(el: HTMLElement, d: number) {
    el.style.setProperty('--d', String(d));
    el.style.setProperty('--ad', String(Math.abs(d)));
  }

  function layout() {
    tapes.forEach((el, i) => {
      const prev = Number(el.style.getPropertyValue('--d')) || 0;
      const d = offsetFor(i, prev);
      if (Math.abs(d - prev) > 1) {
        // wrapping around: teleport to the hidden edge, then slide in
        el.classList.add('warp');
        place(el, d > 0 ? 2 : -2);
        void el.offsetWidth;
        el.classList.remove('warp');
      }
      place(el, d);
      el.classList.toggle('is-active', d === 0);
      el.classList.toggle('far', Math.abs(d) > 1);
      el.tabIndex = d === 0 ? 0 : -1;
      el.setAttribute('aria-current', d === 0 ? 'true' : 'false');
      if (d !== 0) resetTilt(el);
    });
    dots.forEach((dot, i) => dot.classList.toggle('on', i === active));
    knob.style.setProperty('--knob', `${-130 + (260 * active) / Math.max(1, n - 1)}deg`);
    if (!busy) setLcd(idleText());
  }

  function go(i: number) {
    if (busy) return;
    hint?.classList.add('done');
    const next = ((i % n) + n) % n;
    if (next === active) return;
    if (loaded) eject();
    active = next;
    layout();
    store.set('tape', String(active));
  }
  const prev = () => go(active - 1);
  const next = () => go(active + 1);

  /* ── Pointer tilt on the front tape ── */
  function resetTilt(el: HTMLElement) {
    const body = el.querySelector<HTMLElement>('.tape-body')!;
    body.classList.remove('tracking');
    body.style.setProperty('--rx', '0deg');
    body.style.setProperty('--ry', '0deg');
  }
  if (finePointer && !reduced) {
    let frame = 0;
    rack.addEventListener('pointermove', (e) => {
      const el = tapes[active];
      const body = el.querySelector<HTMLElement>('.tape-body')!;
      const r = el.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width;
      const y = (e.clientY - r.top) / r.height;
      cancelAnimationFrame(frame);
      if (x < -0.15 || x > 1.15 || y < -0.3 || y > 1.3) return resetTilt(el);
      frame = requestAnimationFrame(() => {
        body.classList.add('tracking');
        body.style.setProperty('--rx', `${((0.5 - y) * 26).toFixed(2)}deg`);
        body.style.setProperty('--ry', `${((x - 0.5) * 34).toFixed(2)}deg`);
        body.style.setProperty('--gx', `${(x * 100).toFixed(1)}%`);
        body.style.setProperty('--gy', `${(y * 100).toFixed(1)}%`);
      });
    });
    rack.addEventListener('pointerleave', () => resetTilt(tapes[active]));
  }

  /* ── Deck mechanics ── */
  function dressDeckTape(src: HTMLAnchorElement) {
    const d = src.dataset;
    deckTape.style.setProperty('--shell', d.shell!);
    deckTape.style.setProperty('--band', d.band!);
    deckTape.style.setProperty('--hub', d.ink!);
    deckTape.querySelector('.c-title')!.textContent = d.label!;
    deckTape.querySelector('.c-side')!.textContent = d.side!;
    deckTape.querySelector('.c-len')!.textContent = d.length!;
    const smalls = deckTape.querySelectorAll('.c-small');
    smalls[smalls.length - 1].textContent = d.note!;
  }

  function press(key: string, hold = false) {
    const k = keys[key];
    if (!k) return;
    sfx.key();
    k.classList.add('pressed');
    if (!hold) setTimeout(() => k.classList.remove('pressed'), 170);
  }

  function startTransport() {
    deck.classList.add('playing');
    deckTape.classList.add('spinning');
    clearInterval(counterTimer);
    counterTimer = window.setInterval(() => {
      counter = (counter + 1) % 1000;
      counterEl.textContent = pad(counter, 3);
    }, 80);
  }
  function stopTransport() {
    deck.classList.remove('playing');
    deckTape.classList.remove('spinning', 'fast');
    keys.play?.classList.remove('pressed');
    clearInterval(counterTimer);
  }

  function shake() {
    door.classList.remove('clunk');
    void door.offsetWidth;
    door.classList.add('clunk');
  }

  /** Reset the in-door cassette to its resting state. */
  function resetSlot() {
    slot.style.transition = '';
    slot.style.transform = '';
    slot.style.opacity = '';
  }

  async function eject(instant = false) {
    stopTransport();
    if (!loaded) {
      tapes.forEach((t) => t.classList.remove('gone'));
      return;
    }
    loaded = false;
    if (instant || reduced) {
      door.classList.remove('loaded', 'open');
      resetSlot();
      tapes.forEach((t) => t.classList.remove('gone'));
      return;
    }
    busy = true;
    sfx.clack();
    door.classList.add('open');
    await wait(300);
    // the tape rises up and out of the open door…
    sfx.slide();
    slot.style.transition = 'transform 0.5s cubic-bezier(.45,0,.7,.35), opacity 0.25s ease-in 0.3s';
    slot.style.transform = `translateY(${-slot.offsetHeight * 1.2}px)`;
    slot.style.opacity = '0';
    await wait(380);
    // …and reappears in the rack
    tapes.forEach((t) => t.classList.remove('gone'));
    await wait(170);
    door.classList.remove('loaded');
    resetSlot();
    door.classList.remove('open');
    await wait(260);
    sfx.clunk();
    shake();
    busy = false;
  }

  /**
   * CSS transform (with transform-origin 0 0) that renders an element sitting at
   * the slot's resting box exactly as the door renders its own cassette:
   * the door's perspective × the window's hinge rotation × a slide along the window.
   * Every keyframe uses the same function list so the browser interpolates each
   * piece smoothly.
   */
  function doorSpace(geo: DoorGeo, k: { ax: number; ay: number; tilt: number; slide: number; scale: number; spin: number }) {
    const { o, b, w, h, persp } = geo;
    return [
      `translate(${k.ax}px, ${k.ay}px)`,
      `translate(${o.x}px, ${o.y}px) perspective(${persp}px) translate(${-o.x}px, ${-o.y}px)`,
      `translate(${b.x}px, ${b.y}px) rotateX(${k.tilt}deg) translate(${-b.x}px, ${-b.y}px)`,
      `translateY(${k.slide}px)`,
      `scale(${k.scale})`,
      `translate(${w / 2}px, ${h / 2}px) rotate(${k.spin}deg) translate(${-w / 2}px, ${-h / 2}px)`,
    ].join(' ');
  }
  type DoorGeo = { o: { x: number; y: number }; b: { x: number; y: number }; w: number; h: number; persp: number };

  async function play() {
    if (busy) return;
    const tape = tapes[active];
    const href = tape.href;
    store.set('tape', String(active));

    if (reduced) {
      location.href = href;
      return;
    }
    busy = true;

    if (!loaded) {
      const svg = tape.querySelector<SVGSVGElement>('.front svg')!;
      dressDeckTape(tape);
      resetSlot();

      // measure everything while the door is still closed (flat)
      const from = svg.getBoundingClientRect();
      const slotBox = slot.getBoundingClientRect();
      const doorBox = door.getBoundingClientRect();
      const winBox = win.getBoundingClientRect();
      const cs = getComputedStyle(door);
      const angle = parseFloat(cs.getPropertyValue('--door-angle')) || -24;
      const w = slotBox.width;
      const h = w * 0.625; // cassette aspect ratio
      const gx = slotBox.left;
      const gy = slotBox.top;
      const geo: DoorGeo = {
        o: { x: doorBox.left + doorBox.width / 2 - gx, y: doorBox.top + doorBox.height / 2 - gy },
        b: { x: winBox.left + winBox.width / 2 - gx, y: winBox.bottom - gy },
        w,
        h,
        persp: parseFloat(cs.perspective) || 700,
      };
      // where the tape hovers, fully clear of the opening, before sliding in
      const above = -(h + (slotBox.top - winBox.top) + 10);

      // 1. the door tilts open
      press('eject');
      sfx.clack();
      door.classList.add('open');
      setLcd('⏏ Open');

      // 2. a copy of the tape lifts off the rack and lines up over the open door
      const ghost = svg.cloneNode(true) as SVGSVGElement;
      ghost.classList.add('tape-ghost');
      Object.assign(ghost.style, { left: `${gx}px`, top: `${gy}px`, width: `${w}px`, height: `${h}px` });
      const ax = from.left - gx;
      const ay = from.top - gy;
      const s0 = from.width / w;
      const lift = Math.min(90, Math.abs(ay) * 0.35);
      const start = doorSpace(geo, { ax, ay, tilt: 0, slide: 0, scale: s0, spin: 0 });
      ghost.style.transform = start;
      document.body.append(ghost);
      tape.classList.add('gone');

      const flight = ghost.animate(
        [
          { transform: start },
          { transform: doorSpace(geo, { ax: ax * 0.5, ay: ay * 0.45 - lift, tilt: 0, slide: above * 0.4, scale: (s0 + 1) / 2, spin: -5 }), offset: 0.42 },
          { transform: doorSpace(geo, { ax: 0, ay: -8, tilt: angle * 0.85, slide: above, scale: 1, spin: 0.6 }), offset: 0.82 },
          { transform: doorSpace(geo, { ax: 0, ay: 0, tilt: angle, slide: above, scale: 1, spin: 0 }) },
        ],
        { duration: 820, easing: 'cubic-bezier(.45,.05,.3,1)', fill: 'forwards' },
      );
      await Promise.race([flight.finished, wait(1600)]);

      // 3. hand over to the door's own cassette (identical transform), which slides down inside
      slot.style.transition = 'none';
      slot.style.transform = `translateY(${above}px)`;
      door.classList.add('loaded');
      ghost.remove();
      void slot.offsetWidth;
      sfx.slide();
      slot.style.transition = 'transform 0.55s cubic-bezier(.3,.6,.25,1)';
      slot.style.transform = 'translateY(0)';
      await wait(560);

      // 4. the door swings shut on it
      door.classList.remove('open');
      await wait(250);
      sfx.clunk();
      shake();
      loaded = true;
      await wait(260);
    }

    // 5. roll tape
    press('play', true);
    setLcd(`▶ Play · ${tape.dataset.label}`);
    sfx.hiss();
    startTransport();
    await wait(1100);

    // 6. warble into the next page
    root.classList.add('leaving');
    await wait(460);
    location.href = href;
  }

  /* ── Wire up ── */
  tapes.forEach((el, i) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      if (dragged) return;
      if (i === active) play();
      else { sfx.key(); go(i); }
    });
  });
  dots.forEach((dot) => dot.addEventListener('click', () => { sfx.key(); go(Number(dot.dataset.go)); }));

  keys.prev?.addEventListener('click', () => { press('prev'); prev(); });
  keys.next?.addEventListener('click', () => { press('next'); next(); });
  keys.play?.addEventListener('click', () => play());
  keys.stop?.addEventListener('click', () => {
    if (busy) return;
    press('stop');
    stopTransport();
    setLcd(loaded ? `■ Stop · ${tapes[active].dataset.label}` : 'No tape', 1400);
  });
  keys.eject?.addEventListener('click', () => {
    if (busy) return;
    press('eject');
    if (loaded) { eject(); setLcd('⏏ Eject', 1100); }
    else {
      // just open and close the empty door
      door.classList.add('open');
      setTimeout(() => { door.classList.remove('open'); sfx.clunk(); }, 420);
      setLcd('Door empty', 1200);
    }
  });
  keys.rec?.addEventListener('click', () => {
    if (busy) return;
    press('rec');
    setLcd('✕ Write-protected', 1600);
  });

  // keyboard
  addEventListener('keydown', (e) => {
    if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey) return;
    const t = e.target as HTMLElement;
    const onControl = t instanceof Element && t.closest('button, a:not(.tape), input, select, textarea');
    switch (e.key) {
      case 'ArrowLeft':
      case 'ArrowUp':
        e.preventDefault(); press('prev'); prev(); tapes[active].focus({ preventScroll: true }); break;
      case 'ArrowRight':
      case 'ArrowDown':
        e.preventDefault(); press('next'); next(); tapes[active].focus({ preventScroll: true }); break;
      case 'Enter':
      case ' ':
        if (onControl) return;
        e.preventDefault(); play(); break;
      case 'Escape':
        if (!busy && loaded) { press('eject'); eject(); }
        break;
    }
  });

  // mouse wheel / trackpad: scroll through the tapes
  let wheelAcc = 0;
  let wheelLock = 0;
  addEventListener(
    'wheel',
    (e) => {
      const pageScrolls = document.documentElement.scrollHeight > innerHeight + 4;
      if (pageScrolls && !rack.contains(e.target as Node)) return;
      e.preventDefault();
      const now = performance.now();
      if (now < wheelLock) return;
      wheelAcc += Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
      if (Math.abs(wheelAcc) > 30) {
        const before = active;
        wheelAcc > 0 ? next() : prev();
        if (active !== before) press(wheelAcc > 0 ? 'next' : 'prev');
        wheelAcc = 0;
        wheelLock = now + 300;
      }
    },
    { passive: false },
  );

  // touch / pointer swipe
  let startX = 0;
  let startY = 0;
  let tracking = false;
  let dragged = false;
  rack.addEventListener('pointerdown', (e) => {
    tracking = true;
    dragged = false;
    startX = e.clientX;
    startY = e.clientY;
  });
  rack.addEventListener('pointermove', (e) => {
    if (!tracking) return;
    const dx = e.clientX - startX;
    if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(e.clientY - startY)) {
      dragged = true;
      tracking = false;
      sfx.key();
      dx < 0 ? next() : prev();
    }
  });
  addEventListener('pointerup', () => {
    tracking = false;
    setTimeout(() => (dragged = false), 0);
  });
  addEventListener('pointercancel', () => (tracking = false));
  rack.addEventListener('dragstart', (e) => e.preventDefault());

  // coming back with the back button (bfcache) — reset the deck
  addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    root.classList.remove('leaving');
    document.querySelectorAll('.tape-ghost').forEach((g) => g.remove());
    stopTransport();
    door.classList.remove('loaded', 'open', 'clunk');
    resetSlot();
    tapes.forEach((t) => t.classList.remove('gone'));
    loaded = false;
    busy = false;
    setLcd(idleText());
    layout();
  });

  dressDeckTape(tapes[active]);
  rack.classList.add('init');
  layout();
  requestAnimationFrame(() => requestAnimationFrame(() => rack.classList.remove('init')));
</script>
